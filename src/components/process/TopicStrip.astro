---
import {topicCounts,subjectHref} from '../../lib/process-subjects';
interface Props { records:{tags?:string[]}[] }
const topics=topicCounts(Astro.props.records);
const visible=topics.slice(0,8);
const remaining=topics.slice(8);
---
{!!topics.length&&<nav class="topic-strip" aria-label="Notebook topics">
 <p class="topic-label">Topics <span>Across all entries</span></p>
 <ul>{visible.map(({tag,count})=><li><a href={subjectHref(tag)} aria-label={`${tag}: ${count} ${count===1?'entry':'entries'}`}>{tag} <span>{count}</span></a></li>)}</ul>
 {!!remaining.length&&<details><summary>All {topics.length} topics</summary><ul>{remaining.map(({tag,count})=><li><a href={subjectHref(tag)} aria-label={`${tag}: ${count} ${count===1?'entry':'entries'}`}>{tag} <span>{count}</span></a></li>)}</ul></details>}
</nav>}
<style>
 .topic-strip { margin-top:1.75rem;border-top:1px solid var(--border);padding-top:1rem; }
 .topic-label { font:.75rem/1.6 var(--font-sans);color:var(--text-secondary);margin:0 0 .75rem; }
 .topic-label span { margin-left:1rem;font-size:.7rem;color:var(--text-tertiary); }
 ul { display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;padding:0;margin:0; }
 a { display:block;padding:.25rem .65rem;border:1px solid var(--border);border-radius:3px;color:var(--accent);text-decoration:none;font:.75rem/1.6 var(--font-sans); }
 a span { margin-left:.4rem;color:var(--text-secondary);font:.65rem var(--font-mono); }
 a:hover { border-color:var(--accent);background:var(--surface); }
 a:focus-visible,summary:focus-visible { outline:2px solid var(--accent);outline-offset:3px; }
 details { margin-top:.7rem; }
 summary { width:fit-content;cursor:pointer;color:var(--accent);font:.75rem/1.6 var(--font-sans); }
 details ul { margin-top:.7rem; }
</style>
