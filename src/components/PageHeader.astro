---
interface Props { title: string; eyebrow?: string; description?: string; }
const { title, eyebrow, description } = Astro.props;
---
<header class="editorial-header">
  {eyebrow && <p class="editorial-eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {description && <p class="editorial-lead">{description}</p>}
  <slot />
</header>
