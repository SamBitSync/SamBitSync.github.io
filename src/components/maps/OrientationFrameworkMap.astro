---
const orientations = [
  {
    id: 'bayesian', number: '01', name: 'Bayesian', cue: 'Inference under uncertainty',
    question: 'What is being inferred, and from what evidence?',
    description: 'Specify the alternatives, priors, and likelihoods. Ask how evidence changes the model’s estimates, and whether that inference is a useful account of the system.',
    applications: [
      'How might expectations across three languages shape the interpretation of an ambiguous word?',
      'What does a predicted token distribution tell us about uncertainty, and what does it leave out?',
      'What is accepted as evidence, and how do competing claims gain or lose support?',
    ],
  },
  {
    id: 'dynamical', number: '02', name: 'Dynamical', cue: 'Change through time',
    question: 'How does the pattern unfold and stabilise?',
    description: 'Follow trajectories through a state space. Ask about stability, transitions, and timescales, then examine whether the chosen variables capture the changes that matter.',
    applications: [
      'How does competition between interpretations unfold during a multilingual response?',
      'How do representations change during training, and when do new patterns become stable?',
      'How do routines and collaborations persist, change, or break down over time?',
    ],
  },
  {
    id: 'mechanistic', number: '03', name: 'Mechanistic', cue: 'Parts and interactions',
    question: 'Which parts and interactions produce the pattern?',
    description: 'Propose an organisation of parts that could account for the observation. Use measurements and interventions to test their roles; a behavioural fit alone does not identify the mechanism.',
    applications: [
      'Which processes could produce the observed response, and what would distinguish their contributions?',
      'Which features or circuits contribute to this output, and what changes when they are perturbed?',
      'Which instruments, procedures, and institutional arrangements enable this research practice?',
    ],
  },
  {
    id: 'semiotic', number: '04', name: 'Semiotic', cue: 'Meaning in a setting',
    question: 'What does the pattern mean, and to whom?',
    description: 'Attend to signs, interpretation, and the practices in which meaning takes shape. Ask whose categories organise the account, and what those categories make visible or obscure.',
    applications: [
      'How do language status, identity, and the experimental setting shape what a response means?',
      'What makes a generated sequence meaningful, and whose interpretation establishes that meaning?',
      'How does a result become recognised as knowledge within a scientific community?',
    ],
  },
];
const subjects = ['Trilingual minds', 'Neural networks', 'Knowledge production'];
---

<figure class="orientation-survey" data-orientation-survey>
  <figcaption class="figure-heading">
    <span class="figure-number">Fig. 01</span>
    <span>Four orientations, one recurring question</span>
  </figcaption>

  <div class="survey-body">
    <div class="survey-chart">
      <svg class="survey-lines" viewBox="0 0 540 300" preserveAspectRatio="none" aria-hidden="true" fill="none">
        <path class="sightlines" d="M112 57L255 145M112 243L255 155M428 57L285 145M428 243L285 155" />
        <path class="comparison" d="M112 88V211M428 88V211" />
        <path class="ticks" d="M108 98L112 92L116 98M108 201L112 207L116 201M424 98L428 92L432 98M424 201L428 207L432 201" />
      </svg>
      <div class="recurring-question">
        <span class="question-mark" aria-hidden="true"></span>
        <span class="question-name">Emergence</span>
        <span class="question-copy">How does a<br />pattern arise?</span>
      </div>
      <div class="orientation-controls" role="group" aria-label="Choose an orientation">
        {orientations.map((orientation, index) => (
          <button class={`orientation-button ${orientation.id}`} type="button"
            data-orientation={orientation.id} aria-pressed={index === 0}
            aria-controls="orientation-reading orientation-applications">
            <span class="orientation-number">{orientation.number}</span>
            <span class="orientation-name">{orientation.name}</span>
            <span class="orientation-cue">{orientation.cue}</span>
          </button>
        ))}
      </div>
      <span class="pair-label inference-pair">inference ↔ unfolding</span>
      <span class="pair-label interpretation-pair">parts ↔ interpretation</span>
    </div>

    <div class="shared-reading" id="orientation-reading" aria-live="polite" aria-atomic="true">
      <p class="reading-label">Selected orientation</p>
      {orientations.map((orientation, index) => (
        <div data-reading={orientation.id} hidden={index !== 0}>
          <p class="reading-name">{orientation.name}</p>
          <h3>{orientation.question}</h3>
          <p class="reading-description">{orientation.description}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="applications" id="orientation-applications" aria-live="polite" aria-atomic="true">
    <p class="applications-label">The same orientation, across different materials</p>
    {orientations.map((orientation, index) => (
      <div class="application-grid" data-applications={orientation.id} hidden={index !== 0}>
        {subjects.map((subject, subjectIndex) => (
          <div class="application">
            <h4>{subject}</h4>
            <p>{orientation.applications[subjectIndex]}</p>
          </div>
        ))}
      </div>
    ))}
  </div>
  <p class="figure-note">Select an orientation to read its question. Lines invite comparison; they do not establish a sequence or an equivalence.</p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-orientation-survey]').forEach((figure) => {
    figure.querySelectorAll<HTMLButtonElement>('[data-orientation]').forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.dataset.orientation;
        figure.querySelectorAll<HTMLButtonElement>('[data-orientation]').forEach((control) => {
          control.setAttribute('aria-pressed', String(control.dataset.orientation === selected));
        });
        figure.querySelectorAll<HTMLElement>('[data-reading]').forEach((panel) => {
          panel.hidden = panel.dataset.reading !== selected;
        });
        figure.querySelectorAll<HTMLElement>('[data-applications]').forEach((panel) => {
          panel.hidden = panel.dataset.applications !== selected;
        });
      });
    });
  });
</script>

<style>
  .orientation-survey { position:relative; margin:2.4rem 0; padding:1.3rem 1.5rem 1rem; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
  .orientation-survey::before,.orientation-survey::after { content:''; position:absolute; width:12px; height:12px; border-color:var(--annotation); opacity:.65; pointer-events:none; }
  .orientation-survey::before { top:-1px; left:0; border-top:1px solid var(--annotation); border-left:1px solid var(--annotation); }
  .orientation-survey::after { bottom:-1px; right:0; border-bottom:1px solid var(--annotation); border-right:1px solid var(--annotation); }
  .figure-heading { display:flex; gap:1.1rem; align-items:baseline; color:var(--text-secondary); font:.76rem/1.5 var(--font-sans); }
  .figure-number { color:var(--annotation); font:.65rem var(--font-mono); text-transform:uppercase; letter-spacing:.08em; white-space:nowrap; }
  .survey-body { display:grid; grid-template-columns:minmax(0,1.6fr) minmax(0,1fr); gap:2rem; align-items:center; margin:1.4rem 0 1.7rem; }
  .survey-chart { position:relative; height:300px; }
  .survey-lines { position:absolute; inset:0; width:100%; height:100%; stroke:var(--border); stroke-width:1; }
  .sightlines { stroke-dasharray:3 5; }
  .comparison,.ticks { stroke:var(--text-tertiary); opacity:.7; }
  .recurring-question { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); display:flex; flex-direction:column; align-items:center; background:var(--bg); padding:.45rem .6rem; text-align:center; }
  .question-mark { width:9px; height:9px; border:1px solid var(--annotation); border-radius:50%; background:var(--bg); margin-bottom:.5rem; }
  .question-name { font:.63rem/1.5 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; color:var(--text-secondary); }
  .question-copy { font:italic 1.2rem/1.2 var(--font-serif); color:var(--text-primary); margin-top:.35rem; }
  .orientation-controls { position:absolute; inset:0; }
  .orientation-button { position:absolute; width:40%; min-height:74px; border:1px solid transparent; border-radius:3px; background:var(--bg); padding:.55rem .4rem; color:var(--text-primary); cursor:pointer; text-align:center; }
  .bayesian { left:0; top:15px; }
  .dynamical { left:0; bottom:15px; }
  .mechanistic { right:0; top:15px; }
  .semiotic { right:0; bottom:15px; }
  .orientation-button[aria-pressed='true'] { border-color:var(--accent); background:var(--accent-subtle); }
  .orientation-button:hover { border-color:var(--border); }
  .orientation-button[aria-pressed='true']:hover { border-color:var(--accent); }
  .orientation-button:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  .orientation-number { display:block; color:var(--annotation); font:.58rem/1.5 var(--font-mono); letter-spacing:.06em; }
  .orientation-name { display:block; font:1.25rem/1.3 var(--font-serif); }
  .orientation-cue { display:block; margin-top:.25rem; color:var(--text-secondary); font:.65rem/1.4 var(--font-sans); }
  .pair-label { position:absolute; top:50%; transform:translate(-50%,-50%); background:var(--bg); padding:.3rem .1rem; color:var(--text-tertiary); font:.55rem/1.4 var(--font-mono); white-space:nowrap; }
  .inference-pair { left:20%; }
  .interpretation-pair { left:80%; }
  .shared-reading { border-left:1px solid var(--border); padding-left:1.5rem; }
  .orientation-survey .reading-label,.orientation-survey .applications-label { color:var(--text-tertiary); font:.62rem/1.6 var(--font-mono); text-transform:uppercase; letter-spacing:.07em; margin:0 0 .75rem; }
  .orientation-survey .reading-name { font:.75rem/1.5 var(--font-sans); color:var(--accent); margin:0 0 .45rem; }
  .orientation-survey h3 { font:1.5rem/1.18 var(--font-serif); color:var(--text-primary); margin:0 0 .8rem; }
  .orientation-survey .reading-description { font:.85rem/1.75 var(--font-sans); color:var(--text-secondary); margin:0; }
  .applications { border-top:1px solid var(--border); padding-top:1.1rem; }
  .application-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; }
  [hidden] { display:none !important; }
  .orientation-survey h4 { font:1.1rem/1.3 var(--font-serif); color:var(--text-primary); margin:0 0 .45rem; }
  .orientation-survey .application p { font:.8rem/1.65 var(--font-sans); color:var(--text-secondary); margin:0; }
  .orientation-survey .figure-note { font:.7rem/1.65 var(--font-sans); color:var(--text-tertiary); margin:1.5rem 0 0; }
  @media (max-width:850px) {
    .survey-body { grid-template-columns:1fr; gap:1.5rem; }
    .survey-chart { max-width:600px; width:100%; margin:auto; }
    .shared-reading { padding-left:1.2rem; min-height:165px; }
  }
  @media (max-width:540px) {
    .orientation-survey { padding:1rem 0; }
    .figure-heading { gap:.7rem; font-size:.7rem; }
    .survey-chart { height:auto; display:flex; flex-direction:column; gap:1rem; }
    .survey-lines,.pair-label { display:none; }
    .recurring-question { position:static; transform:none; padding:.5rem 0; }
    .question-copy br { display:none; }
    .orientation-controls { position:static; display:grid; grid-template-columns:1fr 1fr; gap:.5rem; }
    .orientation-button { position:static; width:100%; border-color:var(--border); padding:.7rem .2rem; }
    .bayesian { order:1; } .dynamical { order:2; } .mechanistic { order:3; } .semiotic { order:4; }
    .orientation-name { font-size:1.2rem; }
    .orientation-cue { font-size:.64rem; }
    .shared-reading { min-height:0; }
    .orientation-survey h3 { font-size:1.4rem; }
    .application-grid { grid-template-columns:1fr; gap:1.2rem; }
  }
</style>
