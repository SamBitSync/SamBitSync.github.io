---
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sambit Rimal's portfolio and external memory system - cognitive science research, epistemic practice, and cross-domain synthesis",
} = Astro.props;

const lastUpdated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const canonicalURL = new URL(Astro.url.pathname, 'https://sambitmaps.systems').href;
const fullTitle = title.includes('Sambit') ? title : `${title} | Sambit Rimal`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    <meta name="google-site-verification" content="RzTSpNlIAsHb0itUoSZ_llh-ztYM1sU7Xp4Rk-6hfXk" />
    <meta name="author" content="Sambit Rimal" />
    <meta
      name="keywords"
      content="Sambit Rimal, cognitive science, epistemology, complexity science, research portfolio"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Sambit Rimal" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=IBM+Plex+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- HTMX -->
    <script
      src="https://unpkg.com/htmx.org@2.0.3"
      integrity="sha384-0895/pl2MU10Hqc6jd4RvrthNlDiE9U1tWmX7WRESftEDRosgxNsQG/Ze9YMRzHq"
      crossorigin="anonymous"></script>
  </head>

  <body>
    <script is:inline>
      // Theme initialization - runs before page render to prevent flash
      (function () {
        const getTheme = () => {
          const stored = localStorage.getItem("theme");
          if (stored) return stored;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        };

        document.documentElement.setAttribute("data-theme", getTheme());
      })();
    </script>

    <div id="app">
      <header class="header">
        <nav class="nav">
          <a href="/" class="brand">Sambit</a>

          <div class="nav-links">
            <a href="/maps" class="nav-link">Maps</a>
            <a href="/meta" class="nav-link">Meta</a>
            <a href="/process" class="nav-link">Process</a>
            <a href="/project" class="nav-link">Project</a>
            <button
              id="theme-toggle"
              class="theme-toggle"
              aria-label="Toggle theme"
            >
              <svg
                class="sun-icon"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="10"
                  cy="10"
                  r="4"
                  stroke="currentColor"
                  stroke-width="1.5"></circle>
                <path
                  d="M10 2V4M10 16V18M18 10H16M4 10H2M15.657 4.343L14.243 5.757M5.757 14.243L4.343 15.657M15.657 15.657L14.243 14.243M5.757 5.757L4.343 4.343"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"></path>
              </svg>
              <svg
                class="moon-icon"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </nav>
      </header>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <span class="footer-status">Constantly changing.</span>
        <span class="footer-sep">·</span>
        <a href="/meta/neuraths-boat" class="footer-nodock">No dry dock.</a>
        <span class="footer-sep">·</span>
        <span class="footer-date">Last plank replaced: {lastUpdated}</span>
      </footer>
    </div>
    <div class="noise-overlay"></div>

    <script>
      // Theme toggle handler
      const themeToggle = document.getElementById("theme-toggle");

      function updateTheme() {
        const currentTheme =
          document.documentElement.getAttribute("data-theme");
        const html = document.documentElement;

        // Update icons
        if (currentTheme === "dark") {
          themeToggle?.classList.add("dark");
        } else {
          themeToggle?.classList.remove("dark");
        }
      }

      themeToggle?.addEventListener("click", () => {
        const html = document.documentElement;
        const currentTheme = html.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        html.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);
        updateTheme();
      });

      // Initialize
      updateTheme();
    </script>
  </body>
</html>

<style is:global>
  /* CSS Reset */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    /* Light mode - Warm Paper (Stone based) */
    --bg: #f7f5f0; /* Warm Paper */
    --bg-elevated: #ffffff;
    --surface: #ffffff;
    --surface-elevated: #fafaf9;

    --text-primary: #1c1917; /* Stone 900 */
    --text-secondary: #44403c; /* Stone 700 */
    --text-tertiary: #78716c; /* Stone 500 */

    --border: #e7e5e4; /* Stone 200 */
    --border-subtle: #f5f5f4; /* Stone 100 */

    --accent: #8b4513; /* Burnt sienna */
    --accent-hover: #a0724e; /* Sienna muted */
    --accent-subtle: rgba(139, 69, 19, 0.06);

    /* Modern Shadows - Diffuse & Layered */
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
    --shadow-md:
      0 10px 15px -3px rgb(0 0 0 / 0.05), 0 4px 6px -4px rgb(0 0 0 / 0.05);
    --shadow-lg:
      0 20px 25px -5px rgb(0 0 0 / 0.05), 0 8px 10px -6px rgb(0 0 0 / 0.05);

    /* Radii */
    --radius-sm: 0.375rem;
    --radius-md: 0.75rem;
    --radius-lg: 1rem;
    --radius-xl: 1.5rem;

    /* Typography */
    --font-sans: "DM Sans", system-ui, -apple-system, sans-serif;
    --font-serif: "Newsreader", Georgia, serif;
    --font-mono: "IBM Plex Mono", "SF Mono", monospace;

    /* Spacing */
    --max-width: 1200px;
    --max-width-wide: 1400px;
  }

  /* Dark mode - auto-detect */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #09090b; /* Zinc 950 */
      --bg-elevated: #18181b; /* Zinc 900 */

      --surface: #18181b; /* Zinc 900 */
      --surface-elevated: #27272a; /* Zinc 800 */

      --text-primary: #f4f4f5; /* Zinc 100 */
      --text-secondary: #a1a1aa; /* Zinc 400 */
      --text-tertiary: #52525b; /* Zinc 600 */

      --border: #27272a; /* Zinc 800 */
      --border-subtle: #18181b; /* Zinc 900 */

      --accent: #c17f52; /* Sienna - lighter for dark mode */
      --accent-hover: #d4a574; /* Sienna highlight */
      --accent-subtle: rgba(139, 69, 19, 0.15);

      /* Dark Mode Shadows - Stronger + Border Highlight */
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.5);
      --shadow:
        0 4px 6px -1px rgb(0 0 0 / 0.5), 0 2px 4px -2px rgb(0 0 0 / 0.5);
      --shadow-md:
        0 10px 15px -3px rgb(0 0 0 / 0.5), 0 4px 6px -4px rgb(0 0 0 / 0.5);
      --shadow-lg:
        0 20px 25px -5px rgb(0 0 0 / 0.5), 0 8px 10px -6px rgb(0 0 0 / 0.5);
    }
  }

  /* Dark mode - manual override */
  [data-theme="dark"] {
    --bg: #09090b;
    --bg-elevated: #18181b;

    --surface: #18181b;
    --surface-elevated: #27272a;

    --text-primary: #f4f4f5;
    --text-secondary: #a1a1aa;
    --text-tertiary: #52525b;

    --border: #27272a;
    --border-subtle: #18181b;

    --accent: #c17f52;
    --accent-hover: #d4a574;
    --accent-subtle: rgba(139, 69, 19, 0.15);

    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.5);
    --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.5), 0 2px 4px -2px rgb(0 0 0 / 0.5);
    --shadow-md:
      0 10px 15px -3px rgb(0 0 0 / 0.5), 0 4px 6px -4px rgb(0 0 0 / 0.5);
    --shadow-lg:
      0 20px 25px -5px rgb(0 0 0 / 0.5), 0 8px 10px -6px rgb(0 0 0 / 0.5);
  }

  /* Base Styles */
  html {
    color-scheme: light dark;
  }

  body {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-primary);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  #app {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  /* Header & Navigation */
  .header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 2rem;
  }

  .brand {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .brand:hover {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -0.25rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  /* Theme Toggle */
  .theme-toggle {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .theme-toggle:hover {
    color: var(--text-primary);
    background: var(--surface-elevated);
  }

  .theme-toggle svg {
    position: absolute;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theme-toggle .sun-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle .moon-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0);
  }

  .theme-toggle.dark .sun-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0);
  }

  .theme-toggle.dark .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* Main Content */
  .main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 2rem;
    width: 100%;
  }

  /* Footer */
  .footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 2rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .footer-status {
    color: var(--accent);
    font-style: italic;
    font-family: var(--font-serif);
    font-size: 0.8rem;
  }

  .footer-sep {
    color: var(--text-tertiary);
    opacity: 0.4;
  }

  .footer-nodock {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nodock:hover {
    color: var(--accent);
  }

  .footer-date {
    color: var(--text-tertiary);
  }

  /* Typography */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-weight: 600;
    line-height: 1.2;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    line-height: 1.1;
  }

  h2 {
    font-size: 1.875rem;
    margin: 3rem 0 1.25rem;
    font-weight: 600;
  }

  h3 {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
  }

  h4 {
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }

  p {
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  a:hover {
    color: var(--accent-hover);
  }

  strong {
    font-weight: 600;
    color: var(--text-primary);
  }

  em {
    font-style: italic;
  }

  /* Code */
  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface-elevated);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    border: 1px solid var(--border);
    color: var(--text-primary);
  }

  pre {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 2rem 0;
    line-height: 1.7;
    box-shadow: var(--shadow-sm);
  }

  pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875rem;
  }

  /* Blockquotes */
  blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--text-secondary);
    font-style: italic;
    font-size: 1.0625rem;
  }

  /* Lists */
  ul,
  ol {
    margin: 1.5rem 0;
    padding-left: 1.75rem;
  }

  li {
    margin-bottom: 0.625rem;
    color: var(--text-primary);
  }

  li::marker {
    color: var(--text-tertiary);
  }

  /* Horizontal Rule */
  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  /* Tables */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9375rem;
    overflow-x: auto;
    display: block; /* Allows scrolling on mobile */
  }

  thead {
    background: var(--surface-elevated);
    border-bottom: 2px solid var(--border);
  }

  th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
  }

  td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  tr:last-child td {
    border-bottom: none;
  }

  tbody tr:hover {
    background: var(--surface-elevated);
  }

  /* Images */
  img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  /* Utility Classes */
  .text-secondary {
    color: var(--text-secondary);
  }

  .text-tertiary {
    color: var(--text-tertiary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }

    .nav-links {
      gap: 1.5rem;
    }

    .main {
      padding: 3rem 1.25rem;
    }

    h1 {
      font-size: 2rem;
    }
    h2 {
      font-size: 1.625rem;
    }
    h3 {
      font-size: 1.375rem;
    }
    h4 {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 1.75rem;
    }
    h2 {
      font-size: 1.5rem;
    }
  }
  @media (max-width: 480px) {
    h1 {
      font-size: 1.75rem;
    }
    h2 {
      font-size: 1.5rem;
    }
  }

  /* GRAIN TEXTURE (Global Light Mode) */
  .noise-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  [data-theme="light"] .noise-overlay {
    display: block;
    mix-blend-mode: multiply;
  }
</style>
