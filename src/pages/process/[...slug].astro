---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StationMark from "../../components/StationMark.astro";
import { accessionIndex, stationFor, SHEET_PREFIX } from "../../lib/survey";

export async function getStaticPaths() {
  const process = await getCollection("process");
  const acc = accessionIndex(process, SHEET_PREFIX.process);
  return process.map((post) => ({
    params: { slug: post.id },
    props: { post, accession: acc.get(post.id) },
  }));
}

interface Props {
  post: CollectionEntry<"process">;
  accession: string;
}

const { post, accession } = Astro.props;
const { Content } = await render(post);
const station = stationFor(post.data.dimension);
---

<BaseLayout
  title={`${post.data.title} | Process`}
  description={post.data.description}
>
  <article class="post">
    <header class="post-header">
      <div class="header-meta">
        <span class="survey-id">
          <span class="accession">{accession}</span>
          <span class="station-glyph"><StationMark station={station} size={12} /></span>
        </span>
        <span class={`dimension-badge dimension-${post.data.dimension}`}>
          {post.data.dimension}
        </span>
        <span class={`status-badge status-${post.data.status}`}>
          {post.data.status}
        </span>
      </div>

      <h1>{post.data.title}</h1>

      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          Last updated: {
            post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
      </div>

      {
        post.data.tools && post.data.tools.length > 0 && (
          <div class="tools">
            <strong>Tools:</strong>
            <div class="tool-tags">
              {post.data.tools.map((tool) => (
                <span class="tool-tag">{tool}</span>
              ))}
            </div>
          </div>
        )
      }

      {
        post.data.project && (
          <div class="project-context">
            <strong>Project:</strong>{" "}
            <a href={`/project/${post.data.project}`}>{post.data.project}</a>
          </div>
        )
      }
    </header>

    <div class="post-content">
      <Content />
    </div>

    {
      (post.data.source || post.data.status) && (
        <aside class="metadata-box">
          {post.data.source && (
            <div class="metadata-item">
              <strong>Source:</strong> {post.data.source}
            </div>
          )}
          {post.data.status && (
            <div class="metadata-item">
              <strong>Status:</strong>{" "}
              {post.data.status === "in-progress"
                ? "Formal understanding developing, implementing in practice"
                : post.data.status === "blocked"
                  ? "Blocked"
                  : "Completed"}
            </div>
          )}
        </aside>
      )
    }

    <nav class="post-nav">
      <a href="/process" class="back-link">← Back to Process</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 750px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .header-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .survey-id {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-right: 0.75rem;
    border-right: 1px solid var(--border);
  }

  .station-glyph {
    color: var(--annotation);
    opacity: 0.85;
    display: inline-flex;
  }

  .dimension-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    --badge-color: var(--text-tertiary);
    background: color-mix(in srgb, var(--badge-color) 10%, transparent);
    color: var(--badge-color);
    border: 1px solid color-mix(in srgb, var(--badge-color) 30%, transparent);
  }

  /* Earthy dimension palette - variations on the site's stone/sienna identity */
  .dimension-badge.dimension-formal {
    --badge-color: #57534e; /* stone */
  }

  .dimension-badge.dimension-empirical {
    --badge-color: #6a7f5f; /* sage */
  }

  .dimension-badge.dimension-implementation {
    --badge-color: #8b4513; /* sienna */
  }

  .dimension-badge.dimension-troubleshooting {
    --badge-color: #97742f; /* ochre */
  }

  .dimension-badge.dimension-exploration {
    --badge-color: #a0724e; /* terracotta */
  }

  .dimension-badge.dimension-canon {
    --badge-color: #a14f43; /* brick */
  }

  .dimension-badge.dimension-structured-learning {
    --badge-color: #6e5849; /* umber */
  }

  .dimension-badge.dimension-readings {
    --badge-color: #8a7a33; /* olive */
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    --badge-color: var(--text-tertiary);
    background: color-mix(in srgb, var(--badge-color) 10%, transparent);
    color: var(--badge-color);
    border: 1px solid color-mix(in srgb, var(--badge-color) 30%, transparent);
  }

  .status-badge.status-in-progress {
    --badge-color: #97742f; /* ochre */
  }

  .status-badge.status-blocked {
    --badge-color: #a14f43; /* brick */
  }

  .status-badge.status-completed {
    --badge-color: #46703f; /* forest */
  }

  .post-header h1 {
    font-size: 2.25rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .post-meta {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .tools {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  .tools strong {
    color: var(--text-primary);
    margin-right: 0.5rem;
  }

  .tool-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tool-tag {
    font-size: 0.8125rem;
    padding: 0.25rem 0.625rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .project-context {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }

  .project-context strong {
    color: var(--text-primary);
  }

  .project-context a {
    color: var(--accent);
    text-decoration: none;
  }

  .project-context a:hover {
    text-decoration: underline;
  }

  .post-content {
    font-size: 1.0625rem;
    line-height: 1.75;
    margin-bottom: 3rem;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-top: 1rem;
  }

  .post-content :global(h3) {
    font-size: 1.375rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--surface);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    border: 1px solid var(--border);
  }

  .post-content :global(.formula-box) {
    background: var(--surface);
    border-left: 3px solid var(--border);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    font-weight: 500;
    font-size: 1.125rem;
    text-align: center;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .post-content :global(th) {
    background: var(--surface);
    font-weight: 600;
    color: var(--text-primary);
  }

  .post-content :global(tbody tr:hover) {
    background: var(--surface);
  }

  .post-content :global(img),
  .post-content :global(figure) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 2rem 0;
  }

  .post-content :global(figcaption) {
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  /* Code blocks */
  .post-content :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }

  .metadata-box {
    background: var(--surface);
    border-left: 3px solid var(--border);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
  }

  .metadata-item {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .metadata-item:last-child {
    margin-bottom: 0;
  }

  .metadata-item strong {
    color: var(--text-primary);
    margin-right: 0.5rem;
  }

  .post-nav {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: 1.875rem;
    }

    .post-content {
      font-size: 1rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
    }

    .post-content :global(h3) {
      font-size: 1.25rem;
    }
  }
</style>
