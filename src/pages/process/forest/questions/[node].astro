---
import {getCollection} from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import {type Registry,type Question} from '../../../../lib/forest';
import {recordTags,subjectHref} from '../../../../lib/process-subjects';
export async function getStaticPaths(){
 const bundles=await getCollection('forest');
 return bundles.flatMap(({data:registry})=>registry.nodes.filter(node=>node.note).map(node=>({params:{node:node.id},props:{node,registry}})));
}
const {node,registry}=Astro.props as {node:Question;registry:Registry};
const records=(await getCollection('inquiries')).flatMap(b=>b.data.records);
const encounters=registry.attempts.filter(a=>a.events.some(e=>'node'in e&&e.node===node.id));
const related=records.filter(r=>r.movement==='forest'&&encounters.some(a=>a.id===r.forest_attempt));
const tags=[...new Set(related.flatMap(recordTags))];
const paragraphs=node.note!.split('\n\n');
const siblings=registry.nodes.filter(n=>n.note&&encounters.some(a=>a.events.some(e=>'node'in e&&e.node===n.id)));
const index=siblings.findIndex(n=>n.id===node.id);
const previous=siblings[index-1],next=siblings[index+1];
const pretty=(date:string)=>new Date(date+'T00:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
---
<BaseLayout title={`${node.question} | Forest`} description={paragraphs[0]}>
 <article class="editorial-page question-note">
  <nav class="editorial-subnav"><a href="/process/forest/">← Forest of Ignorance</a>{related[0]&&<a href={`/process/entries/${related[0].id}/`}>Encounter ↗</a>}</nav>
  <PageHeader title={node.question} eyebrow="Forest · Question note"/>
  <div class="tags">{tags.map(tag=><a href={subjectHref(tag)}>{tag}</a>)}</div>
  <p class="metadata">First encountered {pretty(node.first_encountered)}{node.domain&&` · ${node.domain}`}{node.closure&&` · ${node.closure}`}</p>
  {(registry.example||related.some(r=>r.reconstruction))&&<p class="notice">{related.some(r=>r.reconstruction)?'Illustrative subnote drafted from the reconstructed work account. Questions and proposed checks are not additional completed results.':'Example question note.'}</p>}
  <div class="prose">{paragraphs.map(paragraph=><p>{paragraph}</p>)}</div>
  <section><h2>In the encounters</h2>{encounters.map(a=>{const record=related.find(r=>r.movement==='forest'&&r.forest_attempt===a.id);const events=a.events.flatMap((e,i)=>'node'in e&&e.node===node.id?[{type:e.type,number:i+1,note:'note'in e?e.note:undefined}]:[]);return <article class="encounter"><p class="metadata">{pretty(a.date)}</p><h3><a href={record?`/process/entries/${record.id}/`:`/process/forest/${a.root}/?encounter=${a.id}`}>{a.title??a.root} ↗</a></h3><ol>{events.map(e=><li><span class="metadata">{e.number} · {e.type}</span>{e.note&&<p>{e.note}</p>}</li>)}</ol></article>})}</section>
  <nav class="note-navigation" aria-label="Other question notes in this inquiry">{previous&&<a href={`/process/forest/questions/${previous.id}/`}><span>← Previous question</span>{previous.question}</a>}{next&&<a href={`/process/forest/questions/${next.id}/`}><span>Next question →</span>{next.question}</a>}</nav>
 </article>
</BaseLayout>
<style>
 .question-note{max-width:820px}.editorial-subnav{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem}.tags{display:flex;flex-wrap:wrap;gap:.4rem}.tags a{border:1px solid var(--border);border-radius:3px;padding:.2rem .55rem;font-size:.75rem;text-decoration:none;color:var(--accent)}.metadata{font:.7rem/1.8 var(--font-mono);color:var(--text-secondary)}.notice{font:.8rem/1.7 var(--font-sans);color:var(--text-secondary)}.prose{margin:2.5rem 0;max-width:66ch}.prose p{font:400 1.15rem/1.8 var(--font-serif);margin:0 0 1.25rem}section{margin-top:3rem}h2{font:400 1.55rem/1.4 var(--font-serif)}h3{font:400 1.2rem/1.5 var(--font-serif)}.encounter{border-top:1px solid var(--border);padding:1rem 0}.encounter ol{padding-left:1.4rem}.encounter li{margin:.7rem 0}.encounter li p{font-size:.9rem;line-height:1.7}.note-navigation{border-top:1px solid var(--border);padding-top:1.5rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem;margin-top:2rem}.note-navigation a{font:400 1rem/1.6 var(--font-serif);text-decoration:none}.note-navigation span{display:block;font:.75rem/1.8 var(--font-sans);margin-bottom:.4rem}a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}@media(max-width:540px){.note-navigation{grid-template-columns:1fr}}
</style>
