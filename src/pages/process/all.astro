---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const process = (await getCollection("process")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formal = process.filter((p) => p.data.dimension === "formal");
const empirical = process.filter((p) => p.data.dimension === "empirical");
const implementation = process.filter(
    (p) => p.data.dimension === "implementation",
);
const troubleshooting = process.filter(
    (p) => p.data.dimension === "troubleshooting",
);
const exploration = process.filter((p) => p.data.dimension === "exploration");
---

<BaseLayout title="All Process Entries | Sambit">
    <header class="page-header masthead">
        <a href="/process" class="back-link">← Process</a>
        <span class="masthead-overline">Sheet 03 · The field log</span>
        <h1>All Entries by Dimension</h1>
        <p class="subtitle">{process.length} total entries</p>
    </header>

    <div class="controls">
        <div class="filter-tabs">
            <button class="tab active" data-filter="all">
                All <span class="count">{process.length}</span>
            </button>
            <button class="tab" data-filter="exploration">
                Exploration <span class="count">{exploration.length}</span>
            </button>
            <button class="tab" data-filter="formal">
                Formal <span class="count">{formal.length}</span>
            </button>
            <button class="tab" data-filter="empirical">
                Empirical <span class="count">{empirical.length}</span>
            </button>
            <button class="tab" data-filter="implementation">
                Implementation <span class="count"
                    >{implementation.length}</span
                >
            </button>
            <button class="tab" data-filter="troubleshooting">
                Troubleshooting <span class="count"
                    >{troubleshooting.length}</span
                >
            </button>
        </div>
    </div>

    <div class="entries-list">
        {
            process.map((entry) => (
                <a
                    href={`/process/${entry.id}`}
                    class={`entry dimension-${entry.data.dimension}`}
                    data-dimension={entry.data.dimension}
                >
                    <div class="entry-header">
                        <time datetime={entry.data.date.toISOString()}>
                            {entry.data.date.toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "short",
                                day: "numeric",
                            })}
                        </time>
                        <div class="badges">
                            <span
                                class={`dimension-badge dimension-${entry.data.dimension}`}
                            >
                                {entry.data.dimension}
                            </span>
                            <span
                                class={`status-badge status-${entry.data.status}`}
                            >
                                {entry.data.status}
                            </span>
                        </div>
                    </div>

                    <h2>{entry.data.title}</h2>
                    <p class="description">{entry.data.description}</p>

                    {entry.data.project && (
                        <div class="entry-footer">
                            <span class="project-tag">
                                📁{" "}
                                <span class="project-name">
                                    {entry.data.project}
                                </span>
                            </span>
                        </div>
                    )}
                </a>
            ))
        }
    </div>
</BaseLayout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const tabs = document.querySelectorAll(".tab");
        const entries = document.querySelectorAll(".entry");

        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const filter = tab.dataset.filter;

                tabs.forEach((t) => t.classList.remove("active"));
                tab.classList.add("active");

                entries.forEach((entry) => {
                    if (
                        filter === "all" ||
                        entry.dataset.dimension === filter
                    ) {
                        entry.style.display = "flex";
                    } else {
                        entry.style.display = "none";
                    }
                });
            });
        });
    });
</script>

<style>
    .page-header {
        margin-bottom: 1.5rem;
    }

    .back-link {
        display: inline-block;
        font-size: 0.875rem;
        color: var(--text-secondary);
        text-decoration: none;
        margin-bottom: 0.5rem;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--accent);
    }

    h1 {
        font-size: 2.25rem;
        margin-bottom: 0.25rem;
    }

    .subtitle {
        font-size: 1rem;
        color: var(--text-secondary);
        margin: 0;
    }

    .controls {
        margin-bottom: 1.5rem;
    }

    .filter-tabs {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .tab {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        font-size: 0.8125rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.15s ease;
        font-weight: 500;
    }

    .tab:hover {
        background: var(--surface);
        border-color: var(--text-tertiary);
    }

    .tab.active {
        background: var(--accent);
        border-color: var(--accent);
        color: white;
    }

    .tab .count {
        font-size: 0.75rem;
        opacity: 0.8;
    }

    .entries-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .entry {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 3px solid var(--border);
        border-radius: 0.5rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
    }

    .entry:hover {
        transform: translateX(2px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        border-color: var(--accent);
    }

    .entry.dimension-exploration {
        border-left-color: #a0724e; /* terracotta */
    }

    .entry.dimension-formal {
        border-left-color: #57534e; /* stone */
    }

    .entry.dimension-empirical {
        border-left-color: #6a7f5f; /* sage */
    }

    .entry.dimension-implementation {
        border-left-color: #8b4513; /* sienna */
    }

    .entry.dimension-troubleshooting {
        border-left-color: #97742f; /* ochre */
    }

    .entry-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    time {
        font-size: 0.8125rem;
        color: var(--text-secondary);
        font-family: var(--font-mono);
    }

    .badges {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .dimension-badge,
    .status-badge {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        padding: 0.1875rem 0.5rem;
        border-radius: 0.25rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        --badge-color: var(--text-tertiary);
        background: color-mix(in srgb, var(--badge-color) 10%, transparent);
        color: var(--badge-color);
        border: 1px solid color-mix(in srgb, var(--badge-color) 30%, transparent);
    }

    /* Earthy dimension palette - variations on the site's stone/sienna identity */
    .dimension-badge.dimension-exploration {
        --badge-color: #a0724e; /* terracotta */
    }

    .dimension-badge.dimension-formal {
        --badge-color: #57534e; /* stone */
    }

    .dimension-badge.dimension-empirical {
        --badge-color: #6a7f5f; /* sage */
    }

    .dimension-badge.dimension-implementation {
        --badge-color: #8b4513; /* sienna */
    }

    .dimension-badge.dimension-troubleshooting {
        --badge-color: #97742f; /* ochre */
    }

    .dimension-badge.dimension-canon {
        --badge-color: #a14f43; /* brick */
    }

    .dimension-badge.dimension-structured-learning {
        --badge-color: #6e5849; /* umber */
    }

    .dimension-badge.dimension-readings {
        --badge-color: #8a7a33; /* olive */
    }

    .status-badge.status-in-progress {
        --badge-color: #97742f; /* ochre */
    }

    .status-badge.status-blocked {
        --badge-color: #a14f43; /* brick */
    }

    .status-badge.status-completed {
        --badge-color: #46703f; /* forest */
    }

    .entry h2 {
        font-size: 1.0625rem;
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
        line-height: 1.4;
    }

    .description {
        font-size: 0.875rem;
        color: var(--text-secondary);
        line-height: 1.5;
        margin: 0;
    }

    .entry-footer {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .project-tag {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.8125rem;
        color: var(--text-secondary);
    }

    .project-name {
        color: var(--accent);
        font-weight: 500;
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 1.875rem;
        }

        .filter-tabs {
            overflow-x: auto;
            flex-wrap: nowrap;
            padding-bottom: 0.25rem;
        }

        .tab {
            white-space: nowrap;
        }

        .entry-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
    }
</style>
