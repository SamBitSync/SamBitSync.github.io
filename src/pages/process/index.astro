---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EntryList from "../../components/EntryList.astro";
import { getTopicInfo } from "../../lib/taxonomy";
const items = (await getCollection("process")).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());

const topics = [...new Set(items.map(entry=>entry.data.project).filter((topic): topic is string => Boolean(topic)))];
const entries = items.map(entry=>({href:`/process/${entry.id}/`,title:entry.data.title,description:entry.data.description,date:entry.data.date,label:entry.data.dimension}));
---
<BaseLayout title="Process" description="Working notes, derivations, and experiments. A record of understanding as it develops."><div class="editorial-page"><PageHeader title="Process" eyebrow="Learning in progress" description="Working notes, derivations, and experiments. A record of understanding as it develops." /><nav class="editorial-subnav" aria-label="Process topics">{topics.map(topic => <a href={`/process/topics/${topic}/`}>{getTopicInfo(topic).title}</a>)}</nav><EntryList entries={entries} />{!entries.length && <p>No entries yet.</p>}</div></BaseLayout>
