---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getTopicInfo, type TopicDef } from "../../../lib/taxonomy";

export async function getStaticPaths() {
    const allProcess = await getCollection("process");

    // Get all unique projects from process entries
    const projects = new Set(
        allProcess.map((p) => p.data.project).filter(Boolean),
    );

    return Array.from(projects).map((project) => {
        // Normalize project name to slug
        const topicSlug = project!.toLowerCase().replace(/\s+/g, "-");

        // Filter entries for this project
        const relevantEntries = allProcess
            .filter((p) => {
                const proj = p.data.project?.toLowerCase().replace(/\s+/g, "-");
                return proj === topicSlug;
            })
            .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

        return {
            params: { topic: topicSlug },
            props: {
                projectKey: project,
                entries: relevantEntries,
            },
        };
    });
}

interface Props {
    projectKey: string;
    entries: CollectionEntry<"process">[];
}

const { projectKey, entries } = Astro.props;

// Get metadata from taxonomy
const topicData = getTopicInfo(projectKey || "");
const topicTitle = topicData.title;

// Calculate stats
const totalEntries = entries.length;
const lastUpdated = entries[0]?.data.date;

// Group by series
interface SeriesData {
    key: string;
    title: string | null;
    description: string | null;
    focus: string | null;
    entries: CollectionEntry<"process">[];
}

const seriesMap = new Map<string, SeriesData>();

// Add entries to series
entries.forEach((entry) => {
    const data = entry.data;
    const sKey = data.series || "unsorted";

    if (!seriesMap.has(sKey)) {
        seriesMap.set(sKey, {
            key: sKey,
            title: data.seriesTitle || null,
            description: null,
            focus: data.seriesFocus || null,
            entries: [],
        });
    }
    seriesMap.get(sKey)!.entries.push(entry);
});

const series = Array.from(seriesMap.values()).sort((a, b) => {
    if (a.key === "unsorted") return 1;
    if (b.key === "unsorted") return -1;
    return a.key.localeCompare(b.key, undefined, { numeric: true });
});

const totalSeries = series.filter((s) => s.key !== "unsorted").length;

// Dimension stats
const dimensionCounts = entries.reduce(
    (acc, entry) => {
        const dim = entry.data.dimension;
        acc[dim] = (acc[dim] || 0) + 1;
        return acc;
    },
    {} as Record<string, number>,
);

const topDimension = Object.entries(dimensionCounts).sort(
    (a, b) => b[1] - a[1],
)[0];

const dimensionIcons: Record<string, string> = {
    exploration: "🔍",
    formal: "📐",
    empirical: "📊",
    implementation: "⚙️",
    troubleshooting: "🔧",
    canon: "🏛️",
    "structured-learning": "🎓",
    readings: "📑",
};

function shouldShowSeriesId(key: string) {
    return key !== "unsorted" && key.length <= 3;
}
---

<BaseLayout title={`${topicTitle} | Process | Sambit`}>
    <div class="topic-layout">
        <main class="main-content">
            <header class="page-header">
                <nav class="breadcrumbs">
                    <a href="/process">Process</a>
                    <span>/</span>
                    <span class="current">{topicTitle}</span>
                </nav>
                <h1>{topicTitle}</h1>
                <p class="description">{topicData.description}</p>
                {
                    lastUpdated && (
                        <p class="subtitle">
                            Last updated{" "}
                            {lastUpdated.toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })}
                        </p>
                    )
                }
            </header>

            {
                topicData.layout === "grid" ? (
                    <div class="course-grid">
                        {entries.map((entry) => (
                            <a
                                href={`/process/${entry.id}`}
                                class="course-card"
                            >
                                <div class="course-card-header">
                                    <span class="course-platform">
                                        {entry.data.seriesTitle || "Course"}
                                    </span>
                                    <span
                                        class={`status-pill status-${entry.data.status}`}
                                    >
                                        {entry.data.status}
                                    </span>
                                </div>
                                <h2>{entry.data.title}</h2>
                                <p class="course-description">
                                    {entry.data.description}
                                </p>
                                <div class="course-footer">
                                    <span class="course-date">
                                    <span class="course-date">
                                        {entry.data.date.toLocaleDateString(
                                            "en-US",
                                            { month: "short", year: "numeric" },
                                        )}
                                    </span>
                                    </span>
                                    <span class="action-link">
                                    <span class="action-link">
                                        View Entry →
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="timeline">
                        {series.map((s) => (
                            <section
                                id={`series-${s.key}`}
                                class="series-section"
                            >
                                {s.key !== "unsorted" && (
                                    <div class="series-header">
                                        <span class="series-label">
                                            Series {s.key}
                                        </span>
                                        {s.title && <h2>{s.title}</h2>}
                                        {s.description && (
                                            <p class="series-focus">
                                                {s.description}
                                            </p>
                                        )}
                                        {s.focus && !s.description && (
                                            <p class="series-focus">
                                                {s.focus}
                                            </p>
                                        )}
                                    </div>
                                )}

                                <div class="entries-list">
                                    {s.entries.map((entry, idx: number) => (
                                        <a
                                            href={`/process/${entry.id}`}
                                            class="entry-card"
                                        >
                                            <div class="entry-icon">
                                                <span
                                                    class="dimension-icon"
                                                    title={entry.data.dimension}
                                                >
                                                    {
                                                        dimensionIcons[
                                                            entry.data.dimension
                                                        ]
                                                    }
                                                </span>
                                            </div>
                                            <div class="entry-body">
                                                <div class="entry-meta">
                                                    <span class="entry-date">
                                                        {entry.data.date.toLocaleDateString(
                                                            "en-US",
                                                            {
                                                                month: "short",
                                                                day: "numeric",
                                                            },
                                                        )}
                                                    </span>
                                                    {s.key !== "unsorted" && (
                                                        <span class="entry-sequence">
                                                            #{s.key}.{idx + 1}
                                                        </span>
                                                    )}
                                                    <span
                                                        class={`status-pill status-${entry.data.status}`}
                                                    >
                                                        {entry.data.status}
                                                    </span>
                                                </div>
                                                <h3 class="entry-title">
                                                    {entry.data.title}
                                                </h3>
                                                <p class="entry-description">
                                                    {entry.data.description}
                                                </p>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        ))}
                    </div>
                )
            }
        </main>

        <aside class="sidebar">
            <div class="sidebar-content">
                <div class="widget stats-widget">
                    <h3>At a Glance</h3>
                    <div class="stats-grid">
                        <div class="stat-item">
                            <span class="stat-value">{totalEntries}</span>
                            <span class="stat-label"
                                >{
                                    topicData.domain === "courses"
                                        ? "Courses"
                                        : "Entries"
                                }
                                <span style="text-transform: capitalize">
                                    {topDimension[0]}
                                </span>
                            </span>
                        </div>
                    </div>
                </div>

                {
                    totalSeries > 0 && (
                        <div class="widget series-widget">
                            <h3>Series</h3>
                            <nav class="series-nav">
                                {series.map((s) => (
                                    <a
                                        href={`#series-${s.key}`}
                                        class="series-link"
                                    >
                                        {shouldShowSeriesId(s.key) && (
                                            <span class="series-id">
                                                {s.key}
                                            </span>
                                        )}
                                        <span class="series-name">
                                            {s.title ||
                                                (s.key === "unsorted"
                                                    ? "Unsorted Entries"
                                                    : s.key)}
                                        </span>
                                        <span class="series-count">
                                            {s.entries.length}
                                        </span>
                                    </a>
                                ))}
                            </nav>
                        </div>
                    )
                }
            </div>
        </aside>
    </div>
</BaseLayout>

<style>
    .topic-layout {
        display: grid;
        grid-template-columns: 1fr 260px;
        gap: 4rem;
        max-width: var(--max-width-wide);
        margin: 0 auto;
        padding-top: 2rem;
    }

    /* Header */
    .page-header {
        margin-bottom: 3rem;
    }

    .breadcrumbs {
        font-size: 0.875rem;
        color: var(--text-tertiary);
        margin-bottom: 1rem;
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .breadcrumbs a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.2s;
    }

    .breadcrumbs a:hover {
        color: var(--text-primary);
    }

    .breadcrumbs .current {
        color: var(--text-primary);
        font-weight: 500;
    }

    h1 {
        font-size: 3rem;
        margin: 0 0 1rem 0;
        line-height: 1.1;
        letter-spacing: -0.03em;
        background: linear-gradient(
            to bottom right,
            var(--text-primary),
            var(--text-secondary)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .description {
        font-size: 1.25rem;
        color: var(--text-secondary);
        max-width: 65ch;
        line-height: 1.6;
        margin-bottom: 1rem;
    }

    .subtitle {
        font-size: 0.875rem;
        color: var(--text-tertiary);
        font-family: var(--font-mono);
    }

    /* Course Grid */
    .course-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
    }

    .course-card {
        background: var(--surface);
        border-radius: var(--radius-lg);
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow);
        border: 1px solid transparent;
        display: flex;
        flex-direction: column;
    }

    .course-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .course-card-header {
        padding: 1.5rem;
        background: linear-gradient(
            to bottom right,
            var(--surface-elevated),
            var(--surface)
        );
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .course-platform {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        color: var(--text-secondary);
    }

    .course-card h2 {
        margin: 1.5rem 1.5rem 0.5rem;
        font-size: 1.5rem;
        line-height: 1.2;
    }

    .course-description {
        margin: 0 1.5rem 1.5rem;
        color: var(--text-secondary);
        font-size: 0.9375rem;
        line-height: 1.6;
        flex: 1;
    }

    .course-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.875rem;
        color: var(--text-tertiary);
    }

    .action-link {
        color: var(--accent);
        font-weight: 500;
    }

    /* Timeline View */
    .timeline {
        position: relative;
        padding-left: 2rem;
        border-left: 2px solid var(--border-subtle);
    }

    .series-section {
        margin-bottom: 4rem;
        position: relative;
    }

    .series-header {
        margin-bottom: 2rem;
        position: relative;
    }

    .series-header::before {
        content: "";
        position: absolute;
        left: -2.6rem; /* Align with timeline line */
        top: 0.5rem;
        width: 1rem;
        height: 1rem;
        background: var(--surface);
        border: 2px solid var(--accent);
        border-radius: 50%;
        z-index: 1;
    }

    .series-label {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
        display: block;
    }

    .series-header h2 {
        font-size: 1.75rem;
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
    }

    .series-focus {
        font-size: 1.125rem;
        color: var(--text-secondary);
        margin: 0;
        max-width: 60ch;
    }

    .entries-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .entry-card {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background: var(--surface);
        border-radius: var(--radius-lg);
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        box-shadow: var(--shadow-sm);
    }

    .entry-card:hover {
        background: var(--surface-elevated);
        box-shadow: var(--shadow-md);
        transform: translateX(4px);
    }

    .entry-icon {
        font-size: 1.5rem;
        padding-top: 0.25rem;
        opacity: 0.8;
    }

    .entry-body {
        flex: 1;
        min-width: 0;
    }

    .entry-meta {
        display: flex;
        gap: 1rem;
        align-items: center;
        font-size: 0.75rem;
        color: var(--text-tertiary);
        margin-bottom: 0.5rem;
        font-family: var(--font-mono);
    }

    .entry-title {
        font-size: 1.25rem;
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
        font-weight: 600;
    }

    .entry-description {
        margin: 0;
        color: var(--text-secondary);
        line-height: 1.6;
    }

    /* Sidebar */
    .sidebar {
        position: sticky;
        top: 6rem;
        height: fit-content;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .widget h3 {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-tertiary);
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .stats-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .series-nav {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .series-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        text-decoration: none;
        color: var(--text-secondary);
        border-radius: var(--radius-md);
        transition: all 0.2s ease;
        background: transparent;
    }

    .series-link:hover {
        background: var(--surface-elevated);
        color: var(--text-primary);
        transform: translateX(4px);
    }

    .series-id {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-tertiary);
        font-weight: 600;
        background: var(--surface-elevated);
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        flex-shrink: 0;
    }

    .series-name {
        flex: 1;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.3;
    }

    .series-count {
        font-size: 0.75rem;
        color: var(--text-tertiary);
        font-variant-numeric: tabular-nums;
    }

    @media (max-width: 900px) {
        .topic-layout {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .timeline {
            padding-left: 1rem;
            border-left: 1px solid var(--border-subtle);
        }

        .series-header::before {
            left: -1.55rem;
            width: 0.8rem;
            height: 0.8rem;
        }
    }

    .status-pill {
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-weight: 600;
        font-size: 0.6875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        white-space: nowrap; /* Prevent wrapping */
        flex-shrink: 0;
    }

    .status-in-progress {
        background: color-mix(in srgb, var(--accent) 15%, transparent);
        color: var(--accent);
        border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    }
    .status-blocked {
        background: color-mix(in srgb, #ef4444 15%, transparent);
        color: #ef4444;
        border: 1px solid color-mix(in srgb, #ef4444 20%, transparent);
    }
    .status-completed {
        background: color-mix(in srgb, #10b981 15%, transparent);
        color: #10b981;
        border: 1px solid color-mix(in srgb, #10b981 20%, transparent);
    }
</style>
