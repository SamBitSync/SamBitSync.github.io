---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EntryList from '../../../components/EntryList.astro';
import { getTopicInfo } from '../../../lib/taxonomy';
export async function getStaticPaths() {
 const entries = await getCollection('process');
 const topics = [...new Set(entries.map(e=>e.data.project).filter((t):t is string=>Boolean(t)))];
 return topics.map(topic=>({params:{topic:topic.toLowerCase().replace(/\s+/g,'-')},props:{topic,items:entries.filter(e=>e.data.project===topic)}}));
}
const {topic,items}=Astro.props;
const info=getTopicInfo(topic);
const entries=items.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).map(e=>({href:`/process/${e.id}/`,title:e.data.title,description:e.data.description,date:e.data.date,label:e.data.dimension}));
---
<BaseLayout title={info.title}><div class="editorial-page"><nav class="editorial-subnav"><a href="/process/">← Process</a></nav><PageHeader title={info.title} eyebrow="Process" description={info.description}/><EntryList entries={entries}/></div></BaseLayout>
