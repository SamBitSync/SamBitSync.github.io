---
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="About Sambit Rimal, this site, education, and affiliations"
>
  <div class="about">
    <PageHeader title="About" eyebrow="Background · Kathmandu, Nepal" />

    <section class="about-section">
      <p class="bio">
        I'm Sambit Rimal, a graduate student in linguistics working across
        psycholinguistics and Science and Technology Studies. I currently work in the
        <a href="https://cogpsychling-lab.github.io/" target="_blank" rel="noreferrer">Cognitive Science &amp; Psycholinguistics Lab</a>
        and am completing an STS capstone at
        <a href="https://theopen.institute/" target="_blank" rel="noreferrer">The Open Institute</a>.
      </p>
    </section>

    <section class="about-section">
      <h2>Education</h2>
      <ul class="record-list">
        <li>
          <div>
            <strong>MA Linguistics <em>(ongoing)</em></strong>
            <span class="record-org">Tribhuvan University</span>
          </div>
        </li>
        <li>
          <div>
            <strong>Level 5 Diploma in Research &amp; Writing</strong>
            <span class="record-org">The Open Institute</span>
          </div>
        </li>
        <li>
          <div>
            <strong>BSc CSIT</strong>
            <span class="record-org">Tribhuvan University</span>
          </div>
        </li>
      </ul>
    </section>

    <section class="about-section">
      <h2>Affiliations</h2>
      <ul class="record-list">
        <li>
          <div>
            <strong
              ><a href="https://cogpsychling-lab.github.io/" target="_blank" rel="noreferrer"
                >Cognitive Science &amp; Psycholinguistics Lab</a
              ></strong
            >
            <span class="record-org">Graduate Researcher &amp; Student Lab Manager</span>
          </div>
        </li>
        <li>
          <div>
            <strong
              ><a href="https://theopen.institute/" target="_blank" rel="noreferrer"
                >The Open Institute</a
              ></strong
            >
            <span class="record-org">STS capstone</span>
          </div>
        </li>
      </ul>
    </section>

    <section class="about-section">
      <h2>Selected</h2>
      <ul class="record-list record-dated">
        <li>
          <span class="record-year">2025</span>
          <div>
            <strong>Recipient, CogSci × Gorilla Grant</strong>
          </div>
        </li>
        <li>
          <span class="record-year">2025</span>
          <div>
            <strong>Neuromatch Academy</strong>
            <span class="record-org">NeuroAI</span>
          </div>
        </li>
        <li>
          <span class="record-year">2024</span>
          <div>
            <strong>Neuromatch Academy</strong>
            <span class="record-org">Computational Neuroscience</span>
          </div>
        </li>
      </ul>
    </section>

    <section class="about-section conventions">
      <h2 >How I use this site</h2>
      <p class="guide-why">
        A practical fact first: I have aphantasia. Much of my thinking happens outside my head. This site is where it accumulates.
      </p>
      <dl class="reading-guide">
        <div class="guide-row">
          <dt><a href="/maps">Maps</a></dt>
          <dd>
            How ideas connect across domains.
            Start here if you want the shape of the whole thing.
          </dd>
        </div>
        <div class="guide-row">
          <dt><a href="/meta">Frameworks</a></dt>
          <dd>
            What different frameworks help me notice, question, and understand.
            Short passages on the lenses I think with.
          </dd>
        </div>
        <div class="guide-row">
          <dt><a href="/process">Process</a></dt>
          <dd>
            Work in progress: derivations, dead ends,
            troubleshooting.
          </dd>
        </div>
        <div class="guide-row">
          <dt><a href="/project">Projects</a></dt>
          <dd>Things I have built, published, or shared.</dd>
        </div>
      </dl>
    </section>


    <section class="about-section">
      <h2>Contact</h2>
      <ul class="contact-list">
        <li>
          <span class="contact-label">email</span>
          <a href="mailto:sambit.rimal@theopen.institute"
            >sambit.rimal@theopen.institute</a
          >
        </li>
        <li>
          <span class="contact-label">github</span>
          <a href="https://github.com/SamBitSync" target="_blank" rel="noreferrer"
            >SamBitSync</a
          >
        </li>
        <li>
          <span class="contact-label">linkedin</span>
          <a
            href="https://www.linkedin.com/in/sambit-rimal-0876b9116"
            target="_blank"
            rel="noreferrer">sambit-rimal</a
          >
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: 780px;
    margin: 0 auto;
  }

  .about-header h1 {
    font-family: var(--font-serif);
    margin-bottom: 0;
  }

  .about-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .about-section h2 {
    font: 400 1.9rem/1.3 var(--font-serif);
    margin: 0 0 1.25rem;
  }

  .about-section p {
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .about .scale-rule {
    margin: 2.5rem 0;
  }

  .bio {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.75;
    color: var(--text-primary);
    margin: 0;
  }

  .guide-why {
    font-size: 0.9375rem;
    margin-bottom: 1.5rem;
  }

  /* Reading guide */
  .reading-guide {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .guide-row {
    display: flex;
    gap: 1.25rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-row:last-child {
    border-bottom: none;
  }

  .guide-row dt {
    min-width: 6rem;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-top: 0.25em;
  }

  .guide-row dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Records: education, affiliations, selected */
  .record-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .record-list li {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    margin: 0;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .record-list li:last-child {
    border-bottom: none;
  }

  .record-list strong {
    display: block;
    font-weight: 600;
    font-size: 0.9688rem;
  }

  .record-list strong em {
    font-weight: 400;
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }

  .record-org {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
  }

  .record-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    min-width: 3rem;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  /* Contact */
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .contact-list li {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    margin: 0;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    min-width: 6rem;
    flex-shrink: 0;
  }

  .contact-list a { overflow-wrap: anywhere; }

  @media (max-width: 480px) {
    .contact-list li { flex-wrap: wrap; gap: .25rem .75rem; }
    .guide-row {
      flex-direction: column;
      gap: 0.375rem;
    }

    .guide-row dt,
    .contact-label {
      min-width: 0;
    }
  }
</style>
