---
import { getCollection, render } from "astro:content";
import ReadingLayout from "../../layouts/ReadingLayout.astro";
export async function getStaticPaths() { return (await getCollection("project")).map(post=>({params:{slug:post.id},props:{post}})); }
const {post}=Astro.props;
const {Content}=await render(post);
const ids = (post.data.relatedProcess ?? []).map(id => `process/${id}`);
const all = (await Promise.all([getCollection('maps'),getCollection('meta'),getCollection('process'),getCollection('project')])).flat();
const related = ids.flatMap(id=>{ const [collection,slug]=id.includes('/')?id.split('/'):['maps',id]; const item=all.find(e=>e.collection===collection && e.id===slug); return item?[{title:item.collection==='meta'?item.data.framework:item.data.title,href:item.collection==='meta'?`/meta/#${item.id}`:`/${item.collection}/${item.id}/`}]:[]; });
---
<ReadingLayout title={post.data.title} description={post.data.description} collection="Projects" backHref="/project/" date={post.data.date} datePrecision={post.data.datePrecision} label={`${post.data.type} · ${post.data.status}`} wide={false}>
<div slot="context"><div class="editorial-reading-meta">{post.data.collaborators?.length && <span>With {post.data.collaborators.join(', ')}</span>}{post.data.methodology?.length && <span>Methods: {post.data.methodology.join(', ')}</span>}</div><div class="editorial-subnav">{post.data.outputs.map(output=> output.url ? <a href={output.url} target="_blank" rel="noreferrer">{output.label || output.type} ↗</a> : <span>{output.label || output.type}</span>)}</div></div>
<Content />
<aside slot="related" class="editorial-section">{related.length > 0 && <><h2>Related reading</h2><ul>{related.map(item=><li><a href={item.href}>{item.title}</a></li>)}</ul></>}</aside>
</ReadingLayout>
