---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EntryList from "../../components/EntryList.astro";

const items = (await getCollection("project")).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());


const entries = items.map(entry=>({href:`/project/${entry.id}/`,title:entry.data.title,description:entry.data.description,date:entry.data.date,datePrecision:entry.data.datePrecision,label:entry.data.type}));
---
<BaseLayout title="Projects" description="Projects I have built, published, or shared."><div class="editorial-page"><PageHeader title="Projects" eyebrow="Completed work" description="Projects I have built, published, or shared." /><EntryList entries={entries} />{!entries.length && <p>No entries yet.</p>}</div></BaseLayout>
