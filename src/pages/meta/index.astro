---
import { getCollection } from "astro:content";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { frameworkLenses } from "../../lib/framework-lenses";
const entries = (await getCollection("meta")).sort((a,b) => a.data.framework.localeCompare(b.data.framework));
for (const entry of entries) {
  if (!frameworkLenses[entry.id]) throw new Error(`Missing framework lens: ${entry.id}`);
}
---
<BaseLayout title="Frameworks" description="What different frameworks help me notice, question, and understand.">
  <div class="framework-page">
    <PageHeader title="Frameworks" eyebrow="Ways of attending" description="Each framework brings some features of the world into focus and leaves others in the background. I keep them together for the different things they help me notice, question, and understand."><p class="qualification">They do not add up to a single picture, and their disagreements do not disappear. These notes describe what looking through each lens makes available to me.</p></PageHeader>
    <div class="framework-layout">
      <nav aria-label="Frameworks on this page" class="framework-index"><p class="overline">On this page</p>{entries.map(entry => <a href={`#${entry.id}`}>{entry.data.framework}</a>)}</nav>
      <div class="framework-passages">{entries.map(entry => <section id={entry.id} aria-labelledby={`${entry.id}-title`}><h2 id={`${entry.id}-title`}><a href={`#${entry.id}`}>{entry.data.framework}</a></h2><p>{frameworkLenses[entry.id]}</p></section>)}</div>
    </div>
  </div>
</BaseLayout>
<style>
.framework-page { max-width: 1060px; margin: 0 auto; }
.framework-header { max-width: 760px; margin-bottom: 3.5rem; }
.overline { font: .65rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--text-secondary); margin: 0 0 1.2rem; }
.framework-header h1 { font: 400 clamp(2.8rem,5vw,4rem)/1.1 var(--font-serif); letter-spacing: -.035em; margin: 0 0 1.5rem; }
.lead { font: 400 1.45rem/1.5 var(--font-serif); margin: 0 0 1rem; }
.qualification { font-size: .9375rem; line-height: 1.65; color: var(--text-secondary); max-width: 66ch; }
.framework-layout { display: grid; grid-template-columns: 230px minmax(0,1fr); gap: 4rem; border-top: 1px solid var(--border); padding-top: 2rem; }
.framework-index { align-self: start; position: sticky; top: 6rem; max-height: calc(100vh - 8rem); overflow-y: auto; padding: .25rem .5rem .25rem 0; }
.framework-index a { display: block; font-size: .8125rem; line-height: 1.4; padding: .35rem 0; color: var(--text-secondary); text-decoration: none; }
.framework-index a:hover { color: var(--accent); text-decoration: underline; }
.framework-passages section { scroll-margin-top: 7rem; border-bottom: 1px solid var(--border); padding: 0 0 2rem; margin-bottom: 2rem; }
.framework-passages h2 { font: 400 1.75rem/1.2 var(--font-serif); letter-spacing: -.02em; margin: 0 0 .8rem; }
.framework-passages h2 a { color: var(--text-primary); text-decoration: none; }
.framework-passages h2 a:hover { color: var(--accent); }
.framework-passages p { font-size: 1rem; line-height: 1.85; color: var(--text-secondary); margin: 0; max-width: 65ch; }
.framework-passages section:target h2 a { color: var(--accent); }
a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
@media(max-width:700px) { .framework-layout { grid-template-columns: 1fr; gap: 2rem; } .framework-index { position: static; max-height: none; columns: 2; } .framework-index .overline { column-span: all; } .framework-index a { break-inside: avoid; } .framework-header { margin-bottom: 2rem; } .lead { font-size: 1.25rem; } }
@media(max-width:380px) { .framework-index { columns: 1; } }
</style>
