---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EntryList from "../../components/EntryList.astro";

const items = (await getCollection("maps")).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const labels: Record<string,string> = { moc: "Map of ideas", synthesis: "Synthesis", literature: "Literature map", conceptual: "Conceptual model" };

const entries = items.map(entry=>({href:`/maps/${entry.id}/`,title:entry.data.title,description:entry.data.description,date:entry.data.date,label:labels[entry.data.mapType]}));
---
<BaseLayout title="Maps" description="Visual and written explorations of how ideas connect across domains."><div class="editorial-page"><PageHeader title="Maps" eyebrow="Connections across ideas" description="Visual and written explorations of how ideas connect across domains." /><EntryList entries={entries} />{!entries.length && <p>No entries yet.</p>}</div></BaseLayout>
