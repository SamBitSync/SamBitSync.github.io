---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { accessionIndex, SHEET_PREFIX } from "../../lib/survey";

const maps = await getCollection("maps");
const acc = accessionIndex(maps, SHEET_PREFIX.maps);

// One grid, curated reading order: charts of the whole first, then
// syntheses, literature surveys, and specific conceptual models.
// Subtypes are differentiated by ink (top rule + kicker color), with a
// legend up top; the sort keeps same-type cards adjacent as they accumulate.
// Colors are spread across distinct hue families (blue, terracotta,
// plum, forest) so the legend reads at a glance.
const TYPES: Record<string, { order: number; label: string; color: string }> = {
  moc: { order: 0, label: "map of content", color: "var(--accent)" },
  synthesis: { order: 1, label: "synthesis", color: "#a0724e" },
  literature: { order: 2, label: "literature map", color: "#7d5b78" },
  conceptual: { order: 3, label: "conceptual model", color: "#46703f" },
};

const ordered = [...maps].sort((a, b) => {
  const t = TYPES[a.data.mapType].order - TYPES[b.data.mapType].order;
  return t !== 0 ? t : b.data.date.valueOf() - a.data.date.valueOf();
});

// Legend shows only the types present, with counts.
const legend = Object.entries(TYPES)
  .map(([slug, meta]) => ({
    ...meta,
    count: maps.filter((m) => m.data.mapType === slug).length,
  }))
  .filter((t) => t.count > 0)
  .sort((a, b) => a.order - b.order);

const visualLabels = (types?: string[]) =>
  (types ?? [])
    .map((t) => (t === "animation" ? "anim" : t === "data-viz" ? "data" : t))
    .filter(Boolean);
---

<BaseLayout title="Maps | Sambit">
  <header class="page-header masthead">
    <span class="masthead-overline">Sheet 01 · Charts of the territory</span>
    <h1>Maps</h1>
    <p class="lead">
      Visualizing the topology of knowledge. Cross-domain connections, pattern
      synthesis, and conceptual models.
    </p>
  </header>

  <div class="maps-legend" aria-label="Map types">
    <span class="legend-title">Legend</span>
    {
      legend.map((t) => (
        <span class="legend-item">
          <span class="legend-tick" style={`--type-color: ${t.color};`} />
          {t.label} <span class="legend-count">× {t.count}</span>
        </span>
      ))
    }
  </div>

  <div class="maps-grid">
    {
      ordered.map((map) => (
        <a
          href={`/maps/${map.id}`}
          class="map-card"
          style={`--type-color: ${TYPES[map.data.mapType].color};`}
        >
          <div class="card-top">
            <span class="accession">{acc.get(map.id)}</span>
            <span class="card-kicker">{TYPES[map.data.mapType].label}</span>
            <span class="card-date">
              {map.data.date.toLocaleDateString("en-US", {
                month: "short",
                year: "numeric",
              })}
            </span>
          </div>
          <h2>{map.data.title}</h2>
          <p>{map.data.description}</p>
          <div class="card-foot">
            <div class="aspects">
              {map.data.aspects.slice(0, 3).map((a) => (
                <span class="mini-tag">{a}</span>
              ))}
            </div>
            {visualLabels(map.data.visualType).length > 0 && (
              <div class="visual-icons">
                {visualLabels(map.data.visualType).map((label) => (
                  <span>{label}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 3rem;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .maps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  /* Map legend: colored ticks keyed to card top rules */
  .maps-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .legend-title {
    color: var(--text-tertiary);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend-tick {
    display: inline-block;
    width: 20px;
    height: 4px;
    border-radius: 1px;
    background: var(--type-color);
  }

  /* Dark mode: lift the type inks toward pale linework, the same move
     the accent makes (#2b5d76 -> #8fb4c9), so ticks and rules read. */
  :global([data-theme="dark"]) .legend-tick {
    background: color-mix(in srgb, var(--type-color) 70%, #cfe0ea);
  }

  :global([data-theme="dark"]) .map-card {
    border-top-color: color-mix(
      in srgb,
      var(--type-color, var(--accent)) 70%,
      #cfe0ea
    );
  }

  .legend-count {
    color: var(--text-tertiary);
  }

  /* Index card: hairline border, type-colored top rule, subtle shadow */
  .map-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 4px solid var(--type-color, var(--accent));
    border-radius: 3px;
    box-shadow: var(--shadow-sm);
    padding: 1.125rem 1.375rem 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  .map-card:hover {
    border-color: var(--accent);
    border-top-color: var(--type-color, var(--accent));
  }

  .card-top {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    margin-bottom: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .card-date {
    margin-left: auto;
  }

  .map-card h2 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.35;
    margin: 0 0 0.5rem;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .map-card:hover h2 {
    color: var(--accent);
  }

  .map-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .aspects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .mini-tag {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.125rem 0.5rem;
  }

  .visual-icons {
    display: flex;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .maps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
