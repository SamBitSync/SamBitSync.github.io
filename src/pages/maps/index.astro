---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import MapPreview from "../../components/maps/MapPreview.astro";
import {accessionIndex,SHEET_PREFIX} from '../../lib/survey';

const items = (await getCollection("maps")).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const labels: Record<string,string> = { moc: "Map of ideas", synthesis: "Synthesis", literature: "Literature map", conceptual: "Conceptual exploration" };

const accessions=accessionIndex(items,SHEET_PREFIX.maps);
const pretty=(date:Date)=>date.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
---
<BaseLayout title="Maps" description="Visual and written explorations of how ideas connect across domains.">
 <div class="editorial-page maps-page">
  <PageHeader title="Maps" eyebrow="Connections across ideas" description="Visual and written explorations of how ideas connect across domains." />
  {!!items.length&&<section aria-label="Map catalogue">
   <div class="catalogue-heading"><p>{items.length} maps</p><p>Newest first</p></div>
   <div class="map-catalogue">{items.map(entry=><article class="map-card">
    <div class="card-topline"><span class="accession">{accessions.get(entry.id)}</span><span>{labels[entry.data.mapType]}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
    <div class="map-preview"><MapPreview id={entry.id}/></div>
    <div class="card-copy"><h2><a href={`/maps/${entry.id}/`}>{entry.data.title}</a></h2><p>{entry.data.description}</p></div>
    <footer><time datetime={entry.data.date.toISOString().slice(0,10)}>{pretty(entry.data.date)}</time></footer>
   </article>)}</div>
  </section>}
  {!items.length&&<p>No maps recorded yet.</p>}
 </div>
</BaseLayout>
<style>
 .maps-page { max-width:1100px; }
 .catalogue-heading { display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--border);padding:1rem 0; }
 .catalogue-heading p { margin:0;font:.65rem/1.6 var(--font-mono);letter-spacing:.07em;text-transform:uppercase;color:var(--text-secondary); }
 .map-catalogue { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem; }
 .map-card { position:relative;display:flex;flex-direction:column;min-width:0;padding:1.35rem;border:1px solid var(--border);border-top:2px solid var(--accent);border-radius:3px;background:var(--bg-elevated);transition:border-color .15s ease; }
 .map-card:hover { border-color:var(--accent); }
 .card-topline { display:flex;align-items:center;gap:.8rem;color:var(--text-secondary);font:.65rem/1.6 var(--font-mono); }
 .card-topline .accession { color:var(--annotation); }
 .card-arrow { margin-left:auto;color:var(--accent);font:1rem var(--font-sans); }
 .map-preview { margin:1.1rem 0 1.4rem;padding-bottom:1rem;border-bottom:1px solid var(--border); }
 h2 { font:400 clamp(1.4rem,2.3vw,1.7rem)/1.3 var(--font-serif);letter-spacing:-.015em;margin:0 0 .7rem; }
 h2 a { color:var(--text-primary);text-decoration:none; }
 h2 a::after { content:'';position:absolute;inset:0; }
 h2 a:hover { color:var(--accent); }
 .map-card:focus-within { outline:2px solid var(--accent);outline-offset:4px; }
 .card-copy p { color:var(--text-secondary);font:.9rem/1.75 var(--font-sans);margin:0;max-width:62ch; }
 footer { margin-top:auto;padding-top:1.3rem;color:var(--text-secondary);font:.65rem/1.6 var(--font-mono); }
 @media(max-width:650px){.map-catalogue{grid-template-columns:1fr;gap:1.25rem}.map-card{padding:1.1rem}h2{font-size:1.5rem}}
</style>
