---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const maps = (await getCollection("maps")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Group maps by type for the new layout
const coreMaps = maps.filter(
  (m) => m.data.mapType === "moc" || !m.data.mapType,
);
const syntheses = maps.filter((m) => m.data.mapType === "synthesis");
const conceptMaps = maps.filter((m) => m.data.mapType === "conceptual");
const litMaps = maps.filter((m) => m.data.mapType === "literature");
const otherMaps = maps.filter(
  (m) =>
    !["moc", "synthesis", "conceptual", "literature"].includes(
      m.data.mapType || "",
    ),
);

// Helper to get visual icons
const getVisualIcons = (types: string[]) => {
  if (!types) return null;
  return types
    .map((t) => {
      if (t === "diagram") return "📊";
      if (t === "animation") return "🎬";
      if (t === "data-viz") return "📈";
      if (t === "interactive") return "🎯";
      return "";
    })
    .filter(Boolean);
};
---

<BaseLayout title="Maps | Sambit">
  <div class="maps-container">
    <header class="page-header">
      <div class="header-content">
        <h1>Maps</h1>
        <p class="lead">
          Visualizing the topology of knowledge. Cross-domain connections,
          pattern synthesis, and conceptual models.
        </p>
      </div>
    </header>

    <main class="maps-stack">
      <!-- Section: Core Frameworks (MOCs) -->
      {
        coreMaps.length > 0 && (
          <section class="map-section">
            <header class="section-header">
              <h2>Core Frameworks</h2>
              <p class="section-desc">
                High-level maps of content and orientation frameworks.
              </p>
            </header>
            <div class="maps-grid feature-grid">
              {coreMaps.map((map) => (
                <a href={`/maps/${map.id}`} class="map-card feature-card">
                  <div class="card-visual">
                    <span class="visual-pattern" />
                    <div class="card-badges">
                      <span class="type-badge core">MOC</span>
                      {map.data.visualType?.includes("interactive") && (
                        <span class="interactive-badge">Interactive</span>
                      )}
                    </div>
                  </div>
                  <div class="card-content">
                    <h3>{map.data.title}</h3>
                    <p>{map.data.description}</p>
                    <div class="card-meta">
                      <span class="date">
                        {map.data.date.toLocaleDateString(undefined, {
                          year: "numeric",
                          month: "short",
                        })}
                      </span>
                      <div class="aspects">
                        {map.data.aspects.slice(0, 3).map((a) => (
                          <span class="mini-tag">{a}</span>
                        ))}
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Section: Syntheses -->
      {
        syntheses.length > 0 && (
          <section class="map-section">
            <header class="section-header">
              <h2>Syntheses</h2>
              <p class="section-desc">
                Deep dives integrating multiple domains and patterns.
              </p>
            </header>
            <div class="maps-grid">
              {syntheses.map((map) => (
                <a href={`/maps/${map.id}`} class="map-card">
                  <div class="card-visual synthesis-visual">
                    <div class="card-badges">
                      <span class="type-badge synthesis">Synthesis</span>
                    </div>
                  </div>
                  <div class="card-content">
                    <h3>{map.data.title}</h3>
                    <p>{map.data.description}</p>
                    <div class="card-meta">
                      <div class="aspects">
                        {map.data.aspects.slice(0, 2).map((a) => (
                          <span class="mini-tag">{a}</span>
                        ))}
                      </div>
                      <div class="visual-icons">
                        {getVisualIcons(map.data.visualType)?.map((icon) => (
                          <span>{icon}</span>
                        ))}
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Section: Literature Reviews -->
      {
        litMaps.length > 0 && (
          <section class="map-section">
            <header class="section-header">
              <h2>Literature Maps</h2>
              <p class="section-desc">
                Surveys of academic landscape and theoretical perspectives.
              </p>
            </header>
            <div class="maps-grid compact-grid">
              {litMaps.map((map) => (
                <a href={`/maps/${map.id}`} class="map-card compact-card">
                  <div class="card-content">
                    <div class="compact-header">
                      <h3>{map.data.title}</h3>
                      <div class="visual-icons">
                        {getVisualIcons(map.data.visualType)?.map((icon) => (
                          <span class="icon" title="Visual">
                            {icon}
                          </span>
                        ))}
                      </div>
                    </div>
                    <p>{map.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Section: Conceptual Models -->
      {
        conceptMaps.length > 0 && (
          <section class="map-section">
            <header class="section-header">
              <h2>Conceptual Models</h2>
              <p class="section-desc">
                Specific mental models and dynamic systems.
              </p>
            </header>
            <div class="maps-grid compact-grid">
              {conceptMaps.map((map) => (
                <a href={`/maps/${map.id}`} class="map-card compact-card">
                  <div class="card-content">
                    <div class="compact-header">
                      <h3>{map.data.title}</h3>
                      {getVisualIcons(map.data.visualType)?.map((icon) => (
                        <span class="icon" title="Visual">
                          {icon}
                        </span>
                      ))}
                    </div>
                    <p>{map.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Section: Other -->
      {
        otherMaps.length > 0 && (
          <section class="map-section">
            <header class="section-header">
              <h2>Library</h2>
            </header>
            <div class="maps-grid">
              {otherMaps.map((map) => (
                <a href={`/maps/${map.id}`} class="map-card">
                  <div class="card-content">
                    <h3>{map.data.title}</h3>
                    <p>{map.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </main>
  </div>
</BaseLayout>

<style>
  .maps-container {
    padding: 2rem 0;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .header-content h1 {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .lead {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .maps-stack {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .map-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-header h2 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0;
  }

  .section-desc {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* Grid Layouts */
  .maps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-grid {
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  }

  .compact-grid {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }

  /* Cards */
  .map-card {
    display: flex;
    flex-direction: column;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
    height: 100%;
  }

  .map-card:hover {
    border-color: var(--accent);
  }

  /* Hide decorative visual header blocks */
  .card-visual {
    display: none;
  }

  .card-badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .type-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.08em;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-tertiary);
  }

  .interactive-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.08em;
    background: var(--accent-subtle);
    border: 1px solid rgba(139, 69, 19, 0.2);
    color: var(--accent);
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .map-card h3 {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .map-card p {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0 0 1.25rem 0;
    line-height: 1.55;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }

  .aspects {
    display: flex;
    gap: 0.4rem;
  }

  .mini-tag {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  /* Compact Card Override */
  .compact-card .card-content {
    padding: 1.25rem;
  }

  .compact-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 0.5rem;
  }

  .compact-header h3 {
    font-size: 1.1rem;
    margin: 0;
  }

  .compact-card p {
    font-size: 0.9rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .visual-icons {
    display: flex;
    gap: 0.25rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 768px) {
    .header-content h1 {
      font-size: 2.5rem;
    }

    .maps-grid,
    .feature-grid,
    .compact-grid {
      grid-template-columns: 1fr;
    }

    .section-header {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
