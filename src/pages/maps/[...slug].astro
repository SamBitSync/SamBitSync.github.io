---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const maps = await getCollection("maps");
  return maps.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"maps">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | Maps`}
  description={post.data.description}
>
  <article class="post">
    <header class="post-header">
      <div class="header-content">
        <h1>{post.data.title}</h1>
        <p class="description">{post.data.description}</p>

        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>
            {
              post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
        </div>

        <div class="header-badges">
          {
            post.data.aspects && post.data.aspects.length > 0 && (
              <div class="tags">
                {post.data.aspects.map((aspect) => (
                  <span class="tag">{aspect}</span>
                ))}
              </div>
            )
          }
          {
            post.data.visualType && post.data.visualType.length > 0 && (
              <div class="visual-indicators">
                {post.data.visualType.map((type) => (
                  <span class="visual-badge">{type}</span>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    {
      post.data.connections && post.data.connections.length > 0 && (
        <aside class="connections">
          <h3>Related Content</h3>
          <ul class="connections-list">
            {(() => {
              // This is a bit of a hack to resolving links without a global context,
              // but works for static generation.
              return post.data.connections.map((connection) => {
                // Handle explicit prefixes like "maps/slug" or "meta/slug"
                let href = "";
                let label = connection;

                if (connection.startsWith("maps/")) {
                  href = `/${connection}`;
                  label = connection.replace("maps/", "");
                } else if (connection.startsWith("meta/")) {
                  href = `/${connection}`;
                  label = connection.replace("meta/", "");
                } else {
                  // Default to maps if no prefix
                  href = `/maps/${connection}`;
                  label = connection;
                }

                // Clean up label - replace dashes with spaces, remove 'moc' suffix, and capitalize
                const readableLabel = label
                  .replace(/-moc$/, "")
                  .split("-")
                  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
                  .join(" ");

                return (
                  <li>
                    <a href={href}>{readableLabel}</a>
                  </li>
                );
              });
            })()}
          </ul>
        </aside>
      )
    }

    <nav class="post-nav">
      <a href="/maps" class="back-link">← Back to Maps</a>
    </nav>
  </article>
</BaseLayout>

<style>
  /* Wider layout for maps to breathe */
  .post {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Cinematic Hero Header */
  .post-header {
    margin-bottom: 4rem;
    padding: 4rem 2rem;
    text-align: center;
    background: radial-gradient(
      circle at center,
      var(--surface) 0%,
      transparent 70%
    );
    border-bottom: 1px solid var(--border);
    border-radius: 1rem;
  }

  .header-content h1 {
    font-family: var(--font-serif);
    font-size: 3.25rem;
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
  }

  .description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto 1.5rem auto;
    line-height: 1.6;
  }

  .post-meta {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .header-badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .tag {
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 2rem;
    color: var(--text-secondary);
  }

  .visual-indicators {
    display: flex;
    gap: 0.5rem;
  }

  .visual-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    padding: 0.25rem 0.625rem;
    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 0.25rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post-content {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 4rem;
    max-width: 800px; /* Text stays readable width */
    margin-left: auto;
    margin-right: auto;
  }

  /* Allow wide elements (like diagrams/canvas) to break out of text column */
  .post-content :global(.wide-visual),
  .post-content :global(canvas),
  .post-content :global(.emergence-map) {
    width: 100%;
    max-width: 1000px;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  /* Enhanced content styles */
  .post-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 2rem;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    font-weight: 600;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding: 1rem 1.5rem;
    margin: 2rem 0;
    background: var(--surface);
    border-radius: 0 0.5rem 0.5rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .connections {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 2rem;
    margin: 3rem auto;
    max-width: 800px;
  }

  .connections h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .connections-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .connections-list li a {
    color: var(--text-primary);
    text-decoration: none;
    display: block;
    padding: 0.25rem 0;
  }

  .connections-list li a:hover {
    color: var(--accent);
  }

  .post-nav {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .header-content h1 {
      font-size: 2.5rem;
    }

    .post-header {
      padding: 2rem 1rem;
    }

    .connections-list {
      grid-template-columns: 1fr;
    }
  }
</style>
