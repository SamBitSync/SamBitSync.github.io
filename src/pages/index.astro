  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .text-link, .research-links { font-size: .8125rem; }
  .text-link span { margin-left: .5rem; }
  .eyebrow { text-transform: uppercase; color: var(--text-secondary); margin: 0; }
  .research .eyebrow { margin: .1rem 0 1rem; }
  .research-lead { font-family: var(--font-serif); font-size: clamp(1.65rem,2.4vw,2rem); line-height: 1.28; letter-spacing: -.015em; margin: 0 0 1.2rem; }
  .research-secondary { font-size: 1rem; line-height: 1.65; color: var(--text-secondary); margin: 0; max-width: 60ch; }
  .research-links { display: flex; flex-wrap: wrap; gap: .75rem 2rem; margin-top: 1.5rem; }
  .research-links span { margin-left: .5rem; }
  .orientation { display: grid; grid-template-columns: 1.6fr 1fr; gap: 2rem; align-items: center; background: var(--bg-elevated); border: 1px solid var(--border); padding: 2rem 2.5rem; position: relative; }
