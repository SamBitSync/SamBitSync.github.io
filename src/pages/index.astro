  .interests li:not(:last-child)::after { content: "·"; margin-left: 1.25rem; }
  .interests a { text-decoration: underline; text-underline-offset: 3px; }
  .forming { color: var(--text-secondary); }
  .forming small { font-size: .7rem; }
  .bearing-label-copy { font-family: var(--font-serif); font-size: 1.2rem; }
  .bearing-label-copy > span { font-family: var(--font-mono); font-size: .65rem; margin-left: .35rem; }
  @media(max-width:600px) { .interests { flex-direction: column; gap: .75rem; } .instrument { width: 100%; max-width: 310px; } }

  .orientation-passages { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; padding-top: .25rem; }
  .orientation-passage { margin: 0; min-width: 0; padding-left: 1rem; position: relative; }
  .orientation-passage::before { content: ""; position: absolute; left: 0; top: .2rem; height: 2.5rem; border-left: 1px solid var(--accent); opacity: .5; }
  .orientation-passage blockquote { font-family: var(--font-serif); font-size: 1rem; font-weight: 400; line-height: 1.55; color: var(--text-secondary); padding: 0; margin: 0 0 .8rem; border: 0; }
  .orientation-passage figcaption { display: grid; gap: .2rem; color: var(--text-secondary); font-size: .6875rem; line-height: 1.5; }
  .orientation-passage .bearing-author { font-weight: 500; }
  .orientation-passage cite { font-style: italic; }
  .orientation-passage cite a { color: var(--text-secondary); }
  @media(max-width:600px) { .orientation-passages { grid-template-columns: 1fr; gap: 1.5rem; } }
  .passages-intro { grid-column: 1 / -1; margin: 0 0 -.75rem; font-family: var(--font-serif); font-size: .9375rem; font-style: normal; line-height: 1.5; color: var(--accent); }
</style>
<script>
  const descriptions: Record<string, string> = {
    philosophy: "Examining the concepts and assumptions I think with.",
    experiments: "Investigating multilingual processing through behavioral experiments.",
    modeling: "Learning to express explanations in mathematical and computational terms.",
  };
  const methodButtons = document.querySelectorAll<HTMLButtonElement>(".method");
  const description = document.getElementById("method-description");
  function selectMethod(button: HTMLButtonElement) {
    const method = button.dataset.method;
    if (!method || !description) return;
    methodButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
    description.textContent = descriptions[method];
  }
  methodButtons.forEach((button) => {
    button.addEventListener("click", () => selectMethod(button));
    button.addEventListener("focus", () => selectMethod(button));
    button.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") selectMethod(button);
    });
  });
</script>
