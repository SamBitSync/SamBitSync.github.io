---
import BaseLayout from "../layouts/BaseLayout.astro";
import StationMark from "../components/StationMark.astro";
import { getCollection } from "astro:content";
import { accessionIndex, accessionRange, stationFor, SHEET_PREFIX } from "../lib/survey";

const maps = await getCollection("maps");
const meta = await getCollection("meta");
const process = await getCollection("process");
const project = await getCollection("project");

const mapsAcc = accessionIndex(maps, SHEET_PREFIX.maps);
const metaAcc = accessionIndex(meta, SHEET_PREFIX.meta);
const processAcc = accessionIndex(process, SHEET_PREFIX.process);
const projectAcc = accessionIndex(project, SHEET_PREFIX.project);

const catalogue = [
  { n: "01", name: "Maps", desc: "Charts of the territory", href: "/maps", range: accessionRange(maps.length, SHEET_PREFIX.maps) },
  { n: "02", name: "Meta", desc: "Instruments and frameworks", href: "/meta", range: accessionRange(meta.length, SHEET_PREFIX.meta) },
  { n: "03", name: "Process", desc: "The field log", href: "/process", range: accessionRange(process.length, SHEET_PREFIX.process) },
  { n: "04", name: "Project", desc: "Finished artifacts", href: "/project", range: accessionRange(project.length, SHEET_PREFIX.project) },
];

type Sounding = { acc: string; date: Date; title: string; href: string };
const soundings: Sounding[] = [
  ...maps.map((e) => ({ acc: mapsAcc.get(e.id)!, date: e.data.date, title: e.data.title, href: `/maps/${e.id}` })),
  ...meta.map((e) => ({ acc: metaAcc.get(e.id)!, date: e.data.date, title: e.data.framework, href: `/meta/${e.id}` })),
  ...process.map((e) => ({ acc: processAcc.get(e.id)!, date: e.data.date, title: e.data.title, href: `/process/${e.id}` })),
  ...project.map((e) => ({ acc: projectAcc.get(e.id)!, date: e.data.date, title: e.data.title, href: `/project/${e.id}` })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);

const neurathAcc = metaAcc.get("neuraths-boat");

// The build date: every deploy is a revision of the sheet. (The footer's
// "last plank replaced" stays derived from content dates; different fact.)
const lastRevision = new Date().toLocaleDateString("en-US", { month: "long", year: "numeric" });

// Satellites: engagements in slow orbit around the survey network.
// href: null means "still forming" (drawn as an open node, not linked).
// period: seconds per revolution. Slow, but visibly in motion.
// Graduations on the outer ring: the orrery reads as a theodolite's
// horizontal circle. Minor tick every 10°, major every 90°.
const graduations = Array.from({ length: 36 }, (_, i) => {
  const deg = i * 10;
  const major = deg % 90 === 0;
  const rad = (deg * Math.PI) / 180;
  const rOuter = 185;
  const rInner = rOuter - (major ? 9 : 4.5);
  return {
    major,
    x1: +(220 + rOuter * Math.sin(rad)).toFixed(2),
    y1: +(220 - rOuter * Math.cos(rad)).toFixed(2),
    x2: +(220 + rInner * Math.sin(rad)).toFixed(2),
    y2: +(220 - rInner * Math.cos(rad)).toFixed(2),
  };
});

const satellites = [
  { name: "semiotics", href: null, start: 20, period: 55 },
  { name: "predictive processing", href: "/meta/predictive-processing", start: 80, period: 75 },
  { name: "bayesian epistemology", href: "/meta/bayesian-epistemology", start: 145, period: 48 },
  { name: "embodied cognition", href: "/meta/embodied-cognition", start: 205, period: 68 },
  { name: "strange loops", href: "/meta/strange-loop", start: 265, period: 60 },
  { name: "event cognition", href: null, start: 325, period: 88 },
];
---

<BaseLayout title="Sambit">
  <div class="sheet plate">
    <!-- Sheet header -->
    <div class="sheet-head">
      <span>Survey of language, minds &amp; knowledge</span>
      <span class="sheet-no">Sheet № 1 · Index</span>
      <span class="sheet-coords">27.7172° N · 85.3240° E</span>
    </div>

    <!-- Main: legend and instrument -->
    <div class="sheet-main">
      <section class="bearings" aria-label="Research bearings">
        <figure class="bearing bearing-problems">
          <p class="bearing-label"><span>BEARING 01</span> · PROBLEMS</p>
          <blockquote>
            “We are not students of some subject matter but students of problems. And problems may cut right across the border of any subject matter or discipline.”
          </blockquote>
          <figcaption>
            <span class="bearing-author">Karl R. Popper</span>
            <cite><a class="bearing-source" href="https://padron.entretemas.com.ve/documentos/Popper-Conjectures-Rwefutations-GrowthOfKnowledge.pdf" target="_blank" rel="noreferrer">Conjectures and Refutations: The Growth of Scientific Knowledge</a></cite>
          </figcaption>
        </figure>

        <figure class="bearing bearing-questions">
          <p class="bearing-label"><span>BEARING 02</span> · QUESTIONS</p>
          <blockquote>
            “… we are endowed with the ability to come to know that there are things about it that we don’t know, that is, with the ability to formulate and to entertain questions whose answers we know we do not know.”
          </blockquote>
          <figcaption>
            <span class="bearing-author">Sylvain Bromberger</span>
            <cite><a class="bearing-source" href="https://web.stanford.edu/group/cslipublications/cslipublications/bromberger-corpus/On-What-We-Know-We-Dont-Know.pdf" target="_blank" rel="noreferrer">On What We Know We Don’t Know: Explanation, Theory, Linguistics, and How Questions Shape Them</a> (1992)</cite>
          </figcaption>
        </figure>
      </section>

      <div class="sheet-positioning">
        <div class="sheet-left">
        <h1 class="sheet-epigraph">
          I meander through questions about <em>language</em>, <em>minds</em>
          and <em>meaning</em>.
        </h1>
        <p class="sheet-legend">
          What accumulates here are maps, notes, projects, and the occasional
          attempt at synthesis.
          <span class="neurath-note">
            Rebuilt at sea, plank by plank.
            <a class="neurath-way" href="/meta/neuraths-boat">Neurath's way.</a>
          </span>
        </p>

        <section class="stations">
          <h2 class="sheet-overline">Stations · present work</h2>
          <ul>
            <li>
              <span class="station-glyph"><StationMark station="experiments" /></span>
              <div>
                <h3>Behavioral experiments</h3>
                <p>Investigating multilingual cognition through psycholinguistic experiments.</p>
                <a class="station-aff" href="https://cogpsychling-lab.github.io/" target="_blank" rel="noreferrer">Cognitive Science &amp; Psycholinguistics Lab</a>
              </div>
            </li>
            <li>
              <span class="station-glyph"><StationMark station="philosophy" /></span>
              <div>
                <h3>STS research</h3>
                <p>An ethnography of how scientific knowledge is produced in an emerging cognitive science community.</p>
                <a class="station-aff" href="https://theopen.institute/" target="_blank" rel="noreferrer">The Open Institute</a>
              </div>
            </li>
            <li>
              <span class="station-glyph"><StationMark station="modeling" /></span>
              <div>
                <h3>Mathematical modeling</h3>
                <p>Learning mathematical and computational tools for explaining cognition.</p>
                <a class="station-aff" href="https://github.com/SamBitSync/modeling-mechanisms" target="_blank" rel="noreferrer">modeling-mechanisms</a>
              </div>
            </li>
          </ul>
        </section>
      </div>

      <div class="sheet-right">
        <svg id="orrery" width="440" height="440" viewBox="0 0 440 440" fill="none" overflow="visible" xmlns="http://www.w3.org/2000/svg">
          <circle cx="220" cy="220" r="130" class="orb-ring"/>
          <circle cx="220" cy="220" r="185" class="orb-ring orb-ring-outer"/>
          {graduations.map((t) => (
            <line class={t.major ? "orb-tick orb-tick-major" : "orb-tick"} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
          ))}
          <path class="orb-tri" d="M 220 90 L 107.4 285 L 332.6 285 Z"/>
          <line class="orb-faint" x1="220" y1="90" x2="220" y2="220"/>
          <line class="orb-faint" x1="107.4" y1="285" x2="220" y2="220"/>
          <line class="orb-faint" x1="332.6" y1="285" x2="220" y2="220"/>
          <circle class="orb-centroid" cx="220" cy="220" r="4"/>
          <text class="orb-centroid-label" x="220" y="240" text-anchor="middle">LANGUAGE</text>
          <circle class="orb-vertex" cx="220" cy="90" r="4"/>
          <circle class="orb-vertex" cx="107.4" cy="285" r="4"/>
          <circle class="orb-vertex" cx="332.6" cy="285" r="4"/>
          <text class="orb-vlabel" x="220" y="76" text-anchor="middle">PHILOSOPHY</text>
          <text class="orb-vlabel" x="104" y="306" text-anchor="middle">EXPERIMENTS</text>
          <text class="orb-vlabel" x="336" y="306" text-anchor="middle">MODELING</text>
          <!-- Satellites: CSS-animated orbit, counter-rotated labels stay upright -->
          {satellites.map((sat) => {
            const inner = (
              <>
                <circle class="sat-dot" cx="220" cy="35" r="4.5" />
                <g
                  class="sat-counter"
                  style={`--start:${sat.start}deg; --period:${sat.period}s; transform-origin: 220px 3px;`}
                >
                  <text class="sat-label" x="220" y="6" text-anchor="middle">
                    {sat.name}
                  </text>
                </g>
              </>
            );
            return sat.href ? (
              <a
                href={sat.href}
                class="sat-orbit"
                style={`--start:${sat.start}deg; --period:${sat.period}s;`}
              >
                {inner}
              </a>
            ) : (
              <g
                class="sat-orbit sat-forming"
                style={`--start:${sat.start}deg; --period:${sat.period}s;`}
              >
                {inner}
              </g>
            );
          })}
        </svg>
        <p class="tri-caption">
          <span class="fig-no">fig. 1</span> · The survey network. Three fixed
          stations sight one phenomenon; the engagements in orbit drift. Open
          nodes are interests still forming. Hover to hold the sky still.
        </p>
      </div>
      </div>
    </div>

    <div class="scale-rule" role="presentation"></div>

    <!-- Bottom: catalogue, soundings, cartouche -->
    <div class="sheet-bottom">
      <div class="sheet-bottom-left">
        <section class="catalogue">
          <h2 class="sheet-overline">Sheet catalogue</h2>
          <ol>
            {catalogue.map((item) => (
              <li>
                <a href={item.href} class="cat-row">
                  <span class="cat-n">{item.n}</span>
                  <span class="cat-name">{item.name}</span>
                  <span class="cat-desc">{item.desc}</span>
                  <span class="cat-leader" aria-hidden="true"></span>
                  <span class="accession">{item.range}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>

        <section class="soundings">
          <h2 class="sheet-overline">Recent soundings</h2>
          <ul>
            {soundings.map((s) => (
              <li>
                <a href={s.href}>
                  <span class="accession">{s.acc}</span>
                  <span class="sounding-date">{s.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span>
                  <span class="sounding-title">{s.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="cartouche">
        <div class="cartouche-inner">
          <h2 class="cartouche-title">Survey of language, minds &amp; knowledge</h2>
          <dl>
            <div><dt>Surveyor</dt><dd>Sambit Rimal</dd></div>
            <div><dt>Base</dt><dd>Kathmandu, Nepal</dd></div>
            <div><dt>Stations</dt><dd>philosophy · experiments · modeling</dd></div>
            <div><dt>Datum</dt><dd>Neurath, 1932. No dry dock.</dd></div>
            <div><dt>Load ratings</dt><dd><span class="lr lr-seedling"></span> seedling &nbsp;<span class="lr lr-budding"></span> budding &nbsp;<span class="lr lr-evergreen"></span> evergreen</dd></div>
            <div><dt>Last revision</dt><dd>{lastRevision}</dd></div>
            <div><dt>Records</dt><dd><a href="https://github.com/SamBitSync" target="_blank" rel="noreferrer">GitHub</a> · <a href="https://www.linkedin.com/in/sambit-rimal-0876b9116" target="_blank" rel="noreferrer">LinkedIn</a> · <a href="/about">About</a></dd></div>
          </dl>
          <p class="cartouche-begin">
            Begin at <span class="accession">{neurathAcc}</span>
            <a href="/meta/neuraths-boat">Neurath's Boat</a>
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .sheet {
    padding: 1.5rem 1.75rem 2rem;
  }

  /* Sheet header */
  .sheet-head {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6563rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.875rem;
    margin-bottom: 3.5rem;
  }

  .sheet-no {
    color: var(--annotation);
  }

  /* Main */
  .sheet-main {
    display: block;
  }

  .bearings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .bearing {
    min-width: 0;
    margin: 0;
  }

  .bearing-label {
    margin: 0 0 1.125rem;
    font-family: var(--font-mono);
    font-size: 0.6563rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--annotation);
  }

  .bearing-label span {
    color: inherit;
  }

  .bearing blockquote {
    margin: 0;
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--annotation) 38%, var(--border));
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.35vw, 1.125rem);
    font-weight: 400;
    font-style: normal;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .bearing figcaption {
    display: grid;
    gap: 0.125rem;
    margin-top: 1rem;
    padding-left: 1.0625rem;
    color: var(--text-tertiary);
  }

  .bearing-author {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bearing cite {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    font-style: italic;
    line-height: 1.45;
  }

  .bearing-source {
    color: inherit;
    text-decoration: none;
  }

  .bearing-source:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sheet-positioning {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30rem;
    gap: 4rem;
    align-items: start;
  }

  .sheet-epigraph {
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 3.4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }

  .sheet-epigraph em {
    font-style: italic;
    color: var(--accent);
  }

  .sheet-legend {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 30rem;
    margin-bottom: 3rem;
  }

  .neurath-note {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.9688rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--text-tertiary);
  }

  .neurath-way {
    display: block;
    width: fit-content;
    color: var(--accent);
  }

  .sheet-overline {
    font-family: var(--font-mono);
    font-size: 0.6563rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 1.375rem;
  }

  /* Stations */
  .stations ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stations li {
    display: flex;
    gap: 1rem;
    margin: 0 0 1.625rem;
  }

  .station-glyph {
    color: var(--annotation);
    opacity: 0.85;
    padding-top: 0.3rem;
  }

  .stations h3 {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
  }

  .stations p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 0.25rem;
    max-width: 27rem;
  }

  .station-aff {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
    text-decoration: none;
  }

  .station-aff:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Instrument */
  .sheet-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 3.5rem 1.25rem 0;
  }

  .orb-ring {
    stroke: color-mix(in srgb, var(--text-tertiary) 60%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .orb-ring-outer {
    opacity: 0.85;
  }

  .orb-tick {
    stroke: color-mix(in srgb, var(--text-tertiary) 65%, transparent);
    stroke-width: 0.7;
  }

  .orb-tick-major {
    stroke: color-mix(in srgb, var(--text-tertiary) 90%, transparent);
    stroke-width: 1;
  }

  .orb-tri {
    stroke: color-mix(in srgb, var(--text-secondary) 78%, transparent);
    stroke-width: 1;
    fill: none;
  }

  /* Cyanotype linework needs more ink: --text-tertiary sits too close to
     the blue-black ground, so step the figure up one level in dark mode. */
  :global([data-theme="dark"]) .orb-ring {
    stroke: color-mix(in srgb, var(--text-secondary) 60%, transparent);
  }

  :global([data-theme="dark"]) .orb-tick {
    stroke: color-mix(in srgb, var(--text-secondary) 65%, transparent);
  }

  :global([data-theme="dark"]) .orb-tick-major {
    stroke: color-mix(in srgb, var(--text-secondary) 95%, transparent);
  }

  :global([data-theme="dark"]) .orb-tri {
    stroke: color-mix(in srgb, var(--text-secondary) 85%, transparent);
  }

  .orb-faint {
    stroke: var(--border);
    stroke-width: 0.4;
    opacity: 0.65;
  }

  .orb-centroid {
    stroke: var(--annotation);
    stroke-width: 1.2;
    fill: none;
    opacity: 0.8;
  }

  .orb-centroid-label,
  .orb-vlabel {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.14em;
    fill: var(--text-secondary);
    paint-order: stroke fill;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .orb-centroid-label {
    fill: var(--annotation);
  }

  .orb-vertex {
    fill: var(--accent);
    opacity: 0.9;
  }

  /* Satellites: pure CSS orbit. The orbit group rotates around the center;
     the label counter-rotates around its own anchor so it stays upright. */
  .sat-orbit {
    transform-origin: 220px 220px;
    transform-box: view-box;
    transform: rotate(var(--start));
    animation-name: orbit;
    animation-duration: var(--period);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .sat-counter {
    transform-box: view-box;
    transform: rotate(calc(-1 * var(--start)));
    animation-name: counter-orbit;
    animation-duration: var(--period);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @keyframes orbit {
    from {
      transform: rotate(var(--start));
    }
    to {
      transform: rotate(calc(var(--start) + 360deg));
    }
  }

  @keyframes counter-orbit {
    from {
      transform: rotate(calc(-1 * var(--start)));
    }
    to {
      transform: rotate(calc(-1 * var(--start) - 360deg));
    }
  }

  /* Hovering the figure holds the sky still */
  #orrery:hover .sat-orbit,
  #orrery:hover .sat-counter {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .sat-orbit,
    .sat-counter {
      animation: none;
    }
  }

  .sat-dot {
    fill: var(--accent);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .sat-forming .sat-dot {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-dasharray: 2 2;
  }

  .sat-label {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--text-tertiary);
    paint-order: stroke fill;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
    transition: fill 0.2s ease;
  }

  .sat-orbit:hover .sat-label {
    fill: var(--accent);
  }

  .sat-orbit:hover .sat-dot {
    opacity: 1;
  }

  a.sat-orbit {
    cursor: pointer;
  }

  .tri-caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-tertiary);
    text-align: center;
    max-width: 290px;
    margin: 0;
  }

  .fig-no {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--annotation);
  }

  /* Bottom */
  .sheet-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 4rem;
    align-items: start;
  }

  /* Catalogue */
  .catalogue {
    margin-bottom: 3rem;
  }

  .catalogue ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .catalogue li {
    margin: 0;
  }

  .cat-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8125rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cat-n {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    min-width: 1.5rem;
  }

  .cat-name {
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    font-weight: 500;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .cat-row:hover .cat-name {
    color: var(--accent);
