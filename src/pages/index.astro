    :global(.main:has(.journal)) { padding: 1.5rem 1.25rem 2.5rem; }
    .edition { font-size: .55rem; letter-spacing: .02em; flex-wrap: wrap; }
    .introduction { grid-template-columns: 1fr; gap: 2rem; padding: 2rem 0; }
    .identity h1 { font-size: clamp(2.7rem, 11vw, 3.5rem); margin-bottom: 1rem; }
    .identity h1 .surname { display: inline; }

    .identity p { max-width: 38ch; }
    .research-lead { font-size: 1.7rem; }
    .research-secondary { font-size: .9375rem; }
    .orientation { grid-template-columns: 1fr; padding: 1.5rem; }
    .orientation h2 { font-size: 2.05rem; }
    .instrument { max-width: 270px; margin: 0 auto; }
    .section-heading { align-items: start; }
    .section-heading > .eyebrow { display: none; }
    .work, .notebook, .bearings { margin-top: 2.5rem; }
    .work-grid, .notebook-grid, .bearings-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .work-grid article { padding: 0 0 1.5rem; border-right: 0; border-bottom: 1px solid var(--border); }
    .work-grid article:last-child { padding-bottom: 0; border-bottom: 0; }
    .notebook-grid { gap: 2rem; }
    .collections > a { padding: .75rem 0; }
    .entry-title { font-size: 1.25rem; }
    .colophon { flex-direction: column; gap: .5rem; }
  }
  .method-diagram { position: relative; width: 100%; }
  .method-diagram svg { display: block; width: 100%; height: auto; }
  .compass-ring { fill: none; stroke: var(--border); stroke-dasharray: 2 5; }
  .compass-triangle { fill: none; stroke: var(--accent); stroke-width: 1; }
  .compass-sights { fill: none; stroke: var(--border); }
  .compass-center { fill: var(--bg-elevated); stroke: var(--annotation); stroke-width: 1.5; }
  .compass-language { font: 11px var(--font-mono); fill: var(--text-primary); letter-spacing: .1em; }
  .method { position: absolute; transform: translateX(-50%); font: .75rem var(--font-sans); padding: .3rem .5rem; border: 1px solid var(--border); border-radius: 3px; background: var(--bg-elevated); color: var(--accent); cursor: pointer; }
  .method[aria-pressed="true"] { border-color: var(--accent); background: var(--accent); color: var(--bg); }
  .method-philosophy { left: 50%; top: 4%; }
  .method-experiments { left: 20%; bottom: 6%; }
  .method-modeling { left: 80%; bottom: 6%; }
  .method-description { min-height: 3.6em; font-size: .8125rem; line-height: 1.5; text-align: center; color: var(--text-secondary); margin: .5rem 0; }
  .interests { grid-column: 1 / -1; border-top: 1px solid var(--border); padding-top: 1rem; display: flex; gap: 1.5rem; align-items: baseline; }
  .interests > .eyebrow { flex-shrink: 0; }
  .interests ul { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; list-style: none; padding: 0; margin: 0; }
