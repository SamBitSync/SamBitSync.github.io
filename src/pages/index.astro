<script>
  const planks = document.querySelectorAll('[data-plank]');
  const targets = document.querySelectorAll('.tri-target');

  function activate(name: string) {
    document.querySelectorAll(`.tri-node[data-vertex="${name}"]`).forEach(el => el.classList.add('active'));
    document.querySelectorAll(`.tri-label[data-vertex="${name}"]`).forEach(el => el.classList.add('active'));
    document.querySelectorAll(`[data-plank="${name}"]`).forEach(el => el.classList.add('active'));
    document.querySelectorAll(`.tri-edge[data-edges*="${name}"]`).forEach(el => el.classList.add('solid'));
  }

  function deactivate(name: string) {
    document.querySelectorAll(`.tri-node[data-vertex="${name}"]`).forEach(el => el.classList.remove('active'));
    document.querySelectorAll(`.tri-label[data-vertex="${name}"]`).forEach(el => el.classList.remove('active'));
    document.querySelectorAll(`[data-plank="${name}"]`).forEach(el => el.classList.remove('active'));
    document.querySelectorAll(`.tri-edge[data-edges*="${name}"]`).forEach(el => el.classList.remove('solid'));
  }

  planks.forEach(plank => {
    const name = (plank as HTMLElement).dataset.plank!;
    plank.addEventListener('mouseenter', () => activate(name));
    plank.addEventListener('mouseleave', () => deactivate(name));
  });

  targets.forEach(target => {
    const name = (target as HTMLElement).dataset.vertex!;
    target.addEventListener('mouseenter', () => activate(name));
    target.addEventListener('mouseleave', () => deactivate(name));
  });

  document.querySelectorAll('.hero-currently li[data-vertex]').forEach(item => {
    const name = (item as HTMLElement).dataset.vertex!;
    item.addEventListener('mouseenter', () => activate(name));
    item.addEventListener('mouseleave', () => deactivate(name));
  });
</script>

