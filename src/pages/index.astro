  }

  .item-info h4 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.25rem 0;
  }

  .item-tags {
    display: flex;
    gap: 0.4rem;
  }

  .item-tags span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-tertiary);
    padding: 0.1rem 0.4rem;
