---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { accessionIndex, accessionRange, SHEET_PREFIX } from "../lib/survey";

const maps = await getCollection("maps");
const meta = await getCollection("meta");
const process = await getCollection("process");
const project = await getCollection("project");

const mapsAcc = accessionIndex(maps, SHEET_PREFIX.maps);
const metaAcc = accessionIndex(meta, SHEET_PREFIX.meta);
const processAcc = accessionIndex(process, SHEET_PREFIX.process);
const projectAcc = accessionIndex(project, SHEET_PREFIX.project);

const catalogue = [
  { n: "01", name: "Maps", desc: "Ideas across domains", href: "/maps", range: accessionRange(maps.length, SHEET_PREFIX.maps) },
  { n: "02", name: "Frameworks", desc: "What each lens helps me notice", href: "/meta", range: accessionRange(meta.length, SHEET_PREFIX.meta) },
  { n: "03", name: "Process", desc: "Work in progress", href: "/process", range: accessionRange(process.length, SHEET_PREFIX.process) },
  { n: "04", name: "Projects", desc: "Finished work", href: "/project", range: accessionRange(project.length, SHEET_PREFIX.project) },
];

type Sounding = { acc: string; date: Date; datePrecision?: "day"|"month"; title: string; href: string; collection: string };
const soundings: Sounding[] = [
  ...maps.map((e) => ({ collection: "Maps", acc: mapsAcc.get(e.id)!, date: e.data.date, title: e.data.title, href: `/maps/${e.id}` })),
  ...meta.map((e) => ({ collection: "Frameworks", acc: metaAcc.get(e.id)!, date: e.data.date, title: e.data.framework, href: `/meta/#${e.id}` })),
  ...process.map((e) => ({ collection: "Process", acc: processAcc.get(e.id)!, date: e.data.date, title: e.data.title, href: `/process/${e.id}` })),
  ...project.map((e) => ({ collection: "Projects", datePrecision: e.data.datePrecision, acc: projectAcc.get(e.id)!, date: e.data.date, title: e.data.title, href: `/project/${e.id}` })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);



// The build date: every deploy is a revision of the sheet. (The footer's
// "last plank replaced" stays derived from content dates; different fact.)
const lastRevision = new Date().toLocaleDateString("en-US", { month: "long", year: "numeric" });


---

<BaseLayout title="Sambit Rimal" description="Sambit Rimal: graduate student in linguistics, working across psycholinguistics and Science and Technology Studies. Research, notes, and questions about language, minds, and meaning.">
  <div class="journal">
    <div class="edition"><span>Research &amp; an open notebook</span><span>Kathmandu, Nepal <span class="edition-mark">↗</span></span></div>
    <header class="introduction">
      <div class="identity">
        <h1>Sambit <span class="surname">Rimal<span class="name-period">.</span></span></h1>
        <p>Graduate student in linguistics, working across psycholinguistics and Science and Technology Studies.</p>
        <a href="/about" class="text-link">More about me <span aria-hidden="true">↗</span></a>
      </div>
      <div class="research">
        <p class="eyebrow">Currently</p>
        <p class="research-lead">I study how language demands shape cognitive processing as it unfolds over time in multilingual speakers.</p>
        <p class="research-secondary">My STS work looks at the infrastructures and improvisations through which cognitive science research becomes possible in Nepal.</p>
        <div class="research-links"><a href="#current-work">What I’m working on <span aria-hidden="true">↓</span></a><a href="#writing">Explore my notes <span aria-hidden="true">↓</span></a></div>
      </div>
    </header>

    <section class="orientation" aria-labelledby="orientation-title">
      <div class="orientation-copy">
        <p class="orientation-preface">If I had to describe my orientation:</p>
        <h2 id="orientation-title">I meander through questions about <em>language, minds, and meaning.</em></h2>
        <p class="orientation-note">This site gathers the maps, notes, projects, and occasional attempts at synthesis that accumulate along the way.</p>
      </div>
      <figure class="instrument">
        <div class="method-diagram">
          <svg viewBox="0 0 360 235" role="img" aria-labelledby="compass-title compass-desc">
            <title id="compass-title">Three approaches to language</title>
            <desc id="compass-desc">Philosophy, experiments, and modeling form a triangle around language. Select an approach below to read how I use it.</desc>
            <circle cx="180" cy="125" r="95" class="compass-ring" />
            <path d="M180 30 L70 200 L290 200 Z" class="compass-triangle" />
            <path d="M180 30 L180 140 M70 200 L180 140 L290 200" class="compass-sights" />
            <circle cx="180" cy="140" r="4" class="compass-center" />
            <text x="180" y="164" text-anchor="middle" class="compass-language">LANGUAGE</text>
          </svg>
          <button class="method method-philosophy" data-method="philosophy" aria-pressed="true" aria-controls="method-description">Philosophy</button>
          <button class="method method-experiments" data-method="experiments" aria-pressed="false" aria-controls="method-description">Experiments</button>
          <button class="method method-modeling" data-method="modeling" aria-pressed="false" aria-controls="method-description">Modeling</button>
        </div>
        <p id="method-description" class="method-description">Examining the concepts and assumptions I think with.</p>
        <figcaption><span>Fig. 01</span> Three approaches to my questions</figcaption>
      </figure>

    <div class="orientation-passages">
        <p class="passages-intro">These two passages capture something of that orientation.</p><figure class="orientation-passage">
          <blockquote id="bearing-problems-quote">
            “We are not students of some subject matter but <span class="quote-annotation">students of problems</span>. And problems may cut right across the border of any subject matter or discipline.”
          </blockquote>
          <figcaption class="bearing-source-note" id="bearing-problems-source">
            <span class="bearing-author">Karl R. Popper</span>
            <cite><a class="bearing-source" href="https://www.amazon.com/Conjectures-Refutations-Scientific-Knowledge-Routledge/dp/0415285941" target="_blank" rel="noreferrer">Conjectures and Refutations: The Growth of Scientific Knowledge</a></cite>
          </figcaption>
        </figure>
<figure class="orientation-passage">
          <blockquote id="bearing-questions-quote">
            “… we are endowed with the ability to come to know that there are things about it that we don’t know, that is, with the ability to formulate and to entertain <span class="quote-annotation">questions whose answers we know we do not know</span>.”
          </blockquote>
          <figcaption class="bearing-source-note" id="bearing-questions-source">
            <span class="bearing-author">Sylvain Bromberger</span>
            <cite><a class="bearing-source" href="https://web.stanford.edu/group/cslipublications/cslipublications/bromberger-corpus/On-What-We-Know-We-Dont-Know.pdf" target="_blank" rel="noreferrer">On What We Know We Don’t Know: Explanation, Theory, Linguistics, and How Questions Shape Them</a> (1992)</cite>
          </figcaption>
        </figure></div>
      <div class="interests" id="themes"><span class="eyebrow">Themes I return to</span><ul><li>signs and interpretation</li><li>representation and computation</li><li>feedback and adaptation</li><li><a href="/themes/evidence-and-explanation/">evidence and explanation</a></li></ul></div>
    </section>



    <section class="work" id="current-work" aria-labelledby="work-title">
      <div class="section-heading"><h2 id="work-title">Present work</h2><span class="eyebrow">Investigating · making · learning</span></div>
      <div class="work-grid">
        <article><span class="work-number">01 / Experiments</span><h3>Psycholinguistics</h3><p>Using mouse-tracking and eye-tracking to investigate processing in multilingual speakers.</p><a href="https://cogpsychling-lab.github.io/" target="_blank" rel="noreferrer">Cognitive Science &amp; Psycholinguistics Lab <span aria-hidden="true">↗</span></a></article>
        <article><span class="work-number">02 / Ethnography</span><h3>Science and Technology Studies</h3><p>An ethnography of everyday research practice in an emerging cognitive science community in Nepal.</p><a href="https://theopen.institute/" target="_blank" rel="noreferrer">The Open Institute <span aria-hidden="true">↗</span></a></article>
        <article><span class="work-number">03 / Learning</span><h3>Learning to model</h3><p>Learning mathematical and computational tools for explaining cognition.</p><a href="https://github.com/SamBitSync/modeling-mechanisms" target="_blank" rel="noreferrer">Modeling mechanisms <span aria-hidden="true">↗</span></a></article>
      </div>
    </section>

    <section class="notebook" id="writing" aria-labelledby="notebook-title">
      <div class="section-heading"><h2 id="notebook-title">The open notebook</h2><span class="eyebrow">Connections, working notes &amp; finished things</span></div>
      <div class="notebook-grid">
        <nav class="collections" aria-label="Writing collections">
          {catalogue.map((item) => <a href={item.href}><span class="collection-number">{item.n}</span><span><strong>{item.name}</strong><span class="collection-description">{item.desc}</span></span><span class="collection-arrow" aria-hidden="true">↗</span></a>)}
          <p class="notebook-note">Rebuilt at sea, plank by plank.<br /><a href="/meta/neuraths-boat">Neurath's way.</a></p>
        </nav>
        <div class="entries"><h3 class="eyebrow">Latest entries</h3><ol>{soundings.map((entry) => <li><a href={entry.href}><span class="entry-meta"><span>{entry.collection} <span class="entry-accession">/ {entry.acc}</span></span><time datetime={entry.datePrecision === "month" ? entry.date.toISOString().slice(0,7) : entry.date.toISOString()}>{entry.date.toLocaleDateString('en-US', {month:'short',day:entry.datePrecision === 'month' ? undefined : 'numeric',year:'numeric'})}</time></span><span class="entry-title">{entry.title}</span></a></li>)}</ol></div>
      </div>
    </section>


    <div class="colophon"><span>Research &amp; an open notebook</span><span>Revision / {lastRevision}</span></div>
  </div>
</BaseLayout>
<style>
